<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.QBank">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ImportActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <!-- 支持从文件管理器/其他应用直接打开题库文件 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.BankDetailActivity" android:exported="false" />
        <!--
          答题页不锁竖屏：一旦在清单里写死 portrait，平板（Android 12L+ / 各家 ROM 的兼容模式）
          会把整个页面塞进一块手机比例的窗口里，两侧留黑边——就是「被收缩成手机」的根因。
          手机端改在 ExamActivity 里按 isTablet 判断锁竖屏；平板跟随设备旋转、铺满全屏。
          configChanges：旋转不重建 Activity，否则会重走「继续答题 / 重新开始」弹窗。
        -->
        <activity
            android:name=".ui.ExamActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:resizeableActivity="true" />
        <activity android:name=".ui.SplitExamActivity" android:exported="false" />
        <activity android:name=".ui.MaterialPopupActivity" android:exported="false" />
        <!-- 答题卡是「弹层」而不是一屏：透明窗口，弹出来时答题页仍在下面可见 -->
        <activity
            android:name=".ui.AnswerCardActivity"
            android:exported="false"
            android:theme="@style/Theme.QBank.Popup" />
        <activity android:name=".ui.ReportActivity" android:exported="false" />
        <!-- 补录答案：逐题填标准答案（键盘弹出时列表要能被顶上去） -->
        <activity
            android:name=".ui.AnswerEntryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
