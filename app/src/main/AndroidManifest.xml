<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 「从链接导入」需要联网下载试卷文件 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 局域网编辑器：手机里跑一个 HTTP 服务，前台服务常驻 + 通知栏（Android 13+ 要通知权限） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      息屏 / 切后台还得接得住电脑的请求：
      - WAKE_LOCK / CHANGE_WIFI_STATE / ACCESS_WIFI_STATE：撑住 Wi-Fi 锁（Wi-Fi 不在屏幕熄灭后进省电模式）
        和 CPU 锁（进程不跟着深度睡眠，accept 的线程能立刻跑）
      - REQUEST_IGNORE_BATTERY_OPTIMIZATIONS：引导用户把本 App 从电池优化白名单里放出来。
        小米 / HyperOS 的「省电策略 → 无限制」入口就在这一页，光靠前台服务拦不住系统冻结进程。
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".QBankApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.QBank"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ImportActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <!-- 支持从文件管理器/其他应用直接打开试卷文件 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.paper.PaperDetailActivity" android:exported="false" />
        <!-- 词库导入：选文档 → 预览 → 入库；返回时 MainActivity 会回调 Refreshable 刷新词库列表 -->
        <activity android:name=".ui.word.WordImportActivity" android:exported="false" />
        <!--
          答题页不锁竖屏：一旦在清单里写死 portrait，平板（Android 12L+ / 各家 ROM 的兼容模式）
          会把整个页面塞进一块手机比例的窗口里，两侧留黑边——就是「被收缩成手机」的根因。
          手机端改在 ExamActivity 里按 isTablet 判断锁竖屏；平板跟随设备旋转、铺满全屏。
          configChanges：旋转不重建 Activity，否则会重走「继续答题 / 重新开始」弹窗。
        -->
        <activity
            android:name=".ui.ExamActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:resizeableActivity="true" />
        <activity android:name=".ui.MaterialPopupActivity" android:exported="false" />
        <!-- 答题卡是「弹层」而不是一屏：透明窗口，弹出来时答题页仍在下面可见 -->
        <activity
            android:name=".ui.AnswerCardActivity"
            android:exported="false"
            android:theme="@style/Theme.QBank.Popup" />
        <activity android:name=".ui.ReportActivity" android:exported="false" />
        <!-- 解析页：与答题页同一套卷面，只读 + 答案解析（错题解析 / 全部解析 / 点题号进入） -->
        <activity
            android:name=".ui.QuestionReviewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:resizeableActivity="true" />
        <!-- 补录答案：逐题填标准答案（键盘弹出时列表要能被顶上去） -->
        <activity
            android:name=".ui.AnswerEntryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 备份包分享：把 cacheDir/backups 下那份 zip 交给系统选择器，能直接存进网盘 App -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          局域网编辑器：前台服务托着 ServerSocket，电脑浏览器连上来加题。

          类型用 specialUse 而不是 dataSync：Android 15 起对 dataSync 类型的前台服务
          有「24 小时内累计 6 小时」的硬上限，超时会被系统直接掐掉（onTimeout），
          手机放一晚第二天网页就再也连不上——和「后台运行一段时间后失联」的症状完全重合。
          specialUse 没有这个计时器，语义也更准：本机起一个局域网网页服务。
        -->
        <service
            android:name=".ui.laneditor.LanEditorService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="lan_web_editor" />
        </service>

        <activity
            android:name=".ui.laneditor.LanEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
          确认弹层：电脑请求发布 / 回滚 / 删除时，只要 App 在前台就盖到当前画面上。
          透明弹片不是页面——不进多任务、独立 task（taskAffinity="" 让它 finish 后
          原地消失，把画面还给底下的界面或别的 App）。
        -->
        <activity
            android:name=".ui.laneditor.LanEditorConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.QBank.Popup" />
    </application>
</manifest>
