<?xml version="1.0" encoding="utf-8"?>
<!--
  可点的描边卡：与 bg_fb_card_line 同款外观，额外套一层水波纹。
  用 ripple 包 shape 而不是给 shape 叠 foreground，点击态才被圆角裁住、不会溢出成方块。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/fb_ripple">

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/fb_card_bg" />
            <corners android:radius="@dimen/fb_card_radius" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fb_card_bg" />
            <corners android:radius="@dimen/fb_card_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/fb_border" />
        </shape>
    </item>
</ripple>
