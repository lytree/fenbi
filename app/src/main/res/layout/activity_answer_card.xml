<?xml version="1.0" encoding="utf-8"?>
<!--
  粉笔风格答题卡（底部弹层）。对齐真机抓取：
  · 顶部「答题卡」标题 + 右上关闭
  · 按模块分组的圆形题号网格（已答=蓝实心，未答=浅灰描边，标记=橙，收藏=粉）
  · 底部通栏「交卷」按钮（实测 #3C7BFC）
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fb_sheet_mask">

    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_fb_sheet"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.62"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 标题行 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/fb_card_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/action_answer_card"
                android:textColor="@color/fb_text_title"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_close"
                android:padding="10dp"
                android:src="@drawable/ic_fb_close" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/fb_divider" />

        <!-- 图例 -->
        <TextView
            android:id="@+id/tvLegend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/fb_card_bg"
            android:paddingHorizontal="16dp"
            android:paddingBottom="10dp"
            android:textColor="@color/fb_text_meta"
            android:textSize="12sp"
            tools:text="共 135 题　已答 2 题　未答 133 题　已标记 0 题" />

        <!-- 题号网格 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:scrollbars="none" />

        <!-- 交卷 -->
        <TextView
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_fb_submit_wide"
            android:gravity="center"
            android:text="@string/action_submit"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
