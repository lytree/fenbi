<?xml version="1.0" encoding="utf-8"?>
<!--
  补录答案：统一标题栏（批量粘贴）+ 顶部说明条 + 逐题答案输入 + 底部「保存并批改」
  用于「做完卷子才拿到答案」的场景——不用准备答案文件，直接在这儿逐题填。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fb_page_bg"
    android:orientation="vertical">

    <com.lytree.qbank.ui.FbTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fb_page_pad"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/fb_page_pad"
        android:background="@drawable/bg_fb_note"
        android:lineSpacingExtra="3dp"
        android:padding="12dp"
        android:textColor="@color/fb_text_tertiary"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/fb_page_pad"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/fb_page_pad"
        android:paddingBottom="16dp"
        android:scrollbars="none" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/fb_divider" />

    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fb_bar_bg"
        android:paddingStart="@dimen/fb_page_pad"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/fb_page_pad"
        android:paddingBottom="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/FbPrimaryButton"
            android:layout_width="match_parent"
            android:text="@string/fill_answer_save" />
    </FrameLayout>
</LinearLayout>
