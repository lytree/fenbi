<?xml version="1.0" encoding="utf-8"?>
<!-- 题库详情：统一标题栏 + 题目卡列表 + 底部通栏主按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/FbPage">

    <com.lytree.qbank.ui.FbTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/fb_space_16"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/empty"
            style="@style/FbEmptyText"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:paddingBottom="0dp"
            android:text="@string/empty_bank_questions"
            android:visibility="gone" />
    </FrameLayout>

    <View style="@style/FbDivider" />

    <FrameLayout
        android:id="@+id/bottomBar"
        style="@style/FbBottomBar">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            style="@style/FbPrimaryButton"
            android:layout_width="match_parent"
            android:text="@string/action_start" />
    </FrameLayout>
</LinearLayout>
