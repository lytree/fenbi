<?xml version="1.0" encoding="utf-8"?>
<!--
  导入页：统一标题栏 + 选文件卡 → 解析结果卡（预览勾选 + 校验问题）+ 底部通栏主按钮
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fb_page_bg"
    android:orientation="vertical">

    <com.lytree.qbank.ui.FbTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===== 第一步：选文件 ===== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/pickPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/fb_page_pad"
                android:paddingTop="16dp"
                android:paddingEnd="@dimen/fb_page_pad"
                android:paddingBottom="20dp">

                <LinearLayout style="@style/FbCard">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/import_pick"
                        android:textColor="@color/fb_text_title"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/FbItemSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:text="支持 JSON / CSV / Excel(xlsx) / TXT，自动识别编码与表头别名，导入前可逐题勾选。"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPick"
                        style="@style/FbPrimaryButton"
                        android:layout_width="match_parent"
                        android:layout_marginTop="18dp"
                        android:text="选择文件" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSample"
                        style="@style/FbTextButton"
                        android:layout_width="match_parent"
                        android:layout_marginTop="4dp"
                        android:text="载入示例题库（体验用）" />
                </LinearLayout>

                <LinearLayout
                    style="@style/FbCard"
                    android:layout_marginTop="@dimen/fb_card_gap_v">

                    <TextView
                        style="@style/FbGroupTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="题库名称" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutName"
                        style="@style/FbInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="留空则用文件名">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===== 第二步：解析结果 ===== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/resultPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/fb_page_pad"
                android:paddingTop="16dp"
                android:paddingEnd="@dimen/fb_page_pad"
                android:paddingBottom="20dp">

                <LinearLayout style="@style/FbCard">

                    <TextView
                        android:id="@+id/tvFile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/fb_text_title"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStat"
                        style="@style/FbItemSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="题目预览"
                        android:textColor="@color/fb_text_title"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAll"
                        style="@style/FbTextButton"
                        android:layout_width="wrap_content"
                        android:text="全选 / 反选" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/tvIssuesTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="2dp"
                    android:text="校验问题"
                    android:textColor="@color/fb_text_title"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listIssues"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <View
        android:id="@+id/bottomDivider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/fb_divider"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fb_bar_bg"
        android:paddingStart="@dimen/fb_page_pad"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/fb_page_pad"
        android:paddingBottom="10dp"
        android:visibility="gone">


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImport"
            style="@style/FbPrimaryButton"
            android:layout_width="match_parent"
            android:text="@string/import_confirm"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
