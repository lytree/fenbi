<?xml version="1.0" encoding="utf-8"?>
<!--
  导入页：统一标题栏 + 选文件卡 → 解析结果卡（预览勾选 + 校验问题）+ 底部通栏主按钮
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/FbPage">

    <com.lytree.qbank.ui.FbTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===== 第一步：选文件 ===== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/pickPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                style="@style/FbPageColumn"
                android:paddingTop="@dimen/fb_space_16"
                android:paddingBottom="@dimen/fb_space_20">

                <LinearLayout style="@style/FbCard">

                    <TextView
                        style="@style/FbCardTitle"
                        android:text="@string/import_pick" />

                    <TextView
                        style="@style/FbBodySm"
                        android:layout_marginTop="@dimen/fb_space_8"
                        android:text="@string/import_pick_hint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPick"
                        style="@style/FbPrimaryButton"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/fb_space_20"
                        android:text="选择文件" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLink"
                        style="@style/FbGhostButton"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/fb_space_12"
                        android:text="@string/import_link_action" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSample"
                        style="@style/FbTextButton"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/fb_space_4"
                        android:text="载入示例（体验用）" />
                </LinearLayout>

                <!-- 词表走另一个页面，但入口只留这一个：全 App 的「导入」都先落到这里 -->
                <LinearLayout
                    style="@style/FbCard"
                    android:layout_marginTop="@dimen/fb_card_gap_v">

                    <TextView
                        style="@style/FbCardTitle"
                        android:text="@string/import_word_title" />

                    <TextView
                        style="@style/FbBodySm"
                        android:layout_marginTop="@dimen/fb_space_8"
                        android:text="@string/import_word_hint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWordImport"
                        style="@style/FbGhostButton"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/fb_space_16"
                        android:text="@string/title_word_import" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===== 第二步：解析结果 ===== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/resultPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                style="@style/FbPageColumn"
                android:paddingTop="@dimen/fb_space_16"
                android:paddingBottom="@dimen/fb_space_20">

                <LinearLayout style="@style/FbCard">

                    <TextView
                        android:id="@+id/tvFile"
                        style="@style/FbCardTitle" />

                    <TextView
                        android:id="@+id/tvStat"
                        style="@style/FbBodySm"
                        android:layout_marginTop="@dimen/fb_space_8" />
                </LinearLayout>

                <!--
                  多文件提示：一次选了几个文件，就有几个标题（每个文件一组）。
                  每个文件拆出的各卷在下面的卷名胶囊里切。
                -->
                <HorizontalScrollView
                    android:id="@+id/fileChipPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fb_card_gap_v"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/fileChipRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!--
                  多卷提示：一份 Excel 里塞了几套题时才会出现（按「试卷」列或多工作表拆开）。
                  单卷文件下整块隐藏，页面与以前完全一样。
                -->
                <LinearLayout
                    android:id="@+id/multiPanel"
                    style="@style/FbCard"
                    android:layout_marginTop="@dimen/fb_card_gap_v"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvMultiTitle"
                        style="@style/FbGroupTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvMultiHint"
                        style="@style/FbBodySm"
                        android:layout_marginTop="@dimen/fb_space_8"
                        android:text="@string/import_multi_hint" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/fb_space_12"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/chipRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- 解析完成后再定卷名 / 限时，确认前随时可改 -->
                <LinearLayout
                    style="@style/FbCard"
                    android:layout_marginTop="@dimen/fb_card_gap_v">

                    <TextView
                        style="@style/FbGroupTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="导入标题" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutName"
                        style="@style/FbInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/fb_space_12"
                        android:hint="标题（默认用文件名，导入后在列表里作为分组）">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputName"
                            style="@style/FbEditText"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvTitleHint"
                        style="@style/FbBodySm"
                        android:layout_marginTop="@dimen/fb_space_8"
                        android:text="@string/import_title_hint"
                        android:visibility="gone" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutDuration"
                        style="@style/FbInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/fb_space_12"
                        android:hint="限时（分钟），0 或留空为不限时">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputDuration"
                            style="@style/FbEditText"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 答案可选：题里带答案也能选择不导入，做完再补录 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/fb_space_16"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/FbRowTitle"
                                android:text="@string/import_with_answers" />

                            <TextView
                                style="@style/FbRowSub"
                                android:text="@string/import_with_answers_hint" />
                        </LinearLayout>

                        <com.lytree.qbank.ui.FbSwitchView
                            android:id="@+id/switchImportAnswers"
                            style="@style/FbSwitch" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fb_section_gap"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/FbSectionTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="题目预览" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAll"
                        style="@style/FbTextButton"
                        android:layout_width="wrap_content"
                        android:text="全选 / 反选" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fb_space_8"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/tvIssuesTitle"
                    style="@style/FbSectionTitle"
                    android:layout_marginTop="@dimen/fb_section_gap"
                    android:text="校验问题"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listIssues"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!--
          解析遮罩：试卷包要解压几百张图再逐题解析，普通文件也要读几 MB 文本。
          这活儿放在 IO 线程做，期间挡住交互，避免连点选择按钮起重复任务。
        -->
        <LinearLayout
            android:id="@+id/loadingPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/fb_page_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:indeterminateTint="@color/fb_primary" />

            <TextView
                android:id="@+id/tvLoading"
                style="@style/FbBodySm"
                android:layout_marginTop="@dimen/fb_space_12"
                android:text="正在解析…" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:id="@+id/bottomDivider"
        style="@style/FbDivider"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/bottomBar"
        style="@style/FbBottomBar"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImport"
            style="@style/FbPrimaryButton"
            android:layout_width="match_parent"
            android:text="@string/import_confirm_paper"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
