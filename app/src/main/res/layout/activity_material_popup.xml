<?xml version="1.0" encoding="utf-8"?>
<!--
  「弹出材料」只读页（独立页面）：
  标题栏：FbTitleBar + A- / A+ 字号；正文：材料铺满整页独立滚动。
  材料带多道题时不进这里——答题页就地左右分屏（见 activity_exam.xml 的 splitBody）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/FbPage">

    <com.lytree.qbank.ui.FbTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <View
        android:id="@+id/topDivider"
        style="@style/FbDivider" />

    <LinearLayout
        android:id="@+id/leftPane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fb_sheet_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/fb_page_pad"
        android:paddingTop="@dimen/fb_space_12"
        android:paddingEnd="@dimen/fb_page_pad">

        <TextView
            style="@style/FbTag"
            android:text="@string/tag_material" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/materialScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/fb_space_8"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/materialContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</LinearLayout>
