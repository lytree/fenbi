<?xml version="1.0" encoding="utf-8"?>
<!--
  解析页：与答题页同一套卷面（题号 + 题型标签 / 题干 16sp / 选项圆标 / 卷面白底通铺），
  只是选项只读，卡尾多出「正确答案 / 你的答案 / 结果 / 解析」那一块。
  · 两种浏览方式，顶栏右侧「多题 / 单题」随时切，档位与答题页共用一份偏好：
    默认多题连续卷面（与答题页默认的多题浏览同一份列表适配器）：一则材料带多道小题时
    材料只在组首题渲染一次，左侧树脊与「材料 N」标签、题间细线都跟答题页一样；
    切到单题就是答题页那套 ViewPager2 一屏一题（材料组页上材料 / 下题目上下分栏）
  · 顶栏标题显示「第 N/M 题」（跟随当前看到的题），右侧「看原题」回试卷定位
  · **没有底部翻页条**：多题上下滚、单题左右滑，手势就是翻题方式（卷面通铺到屏幕底边）
  · 题目卡右上角的「笔」照样能写画：卷面上盖一层可写薄纸（inkOverlay），
    进写画才铺纸拦触摸、并浮出工具条（view_fb_ink_bar.xml）——与答题页同一套交互

  卷面这块用 FrameLayout 叠三层（题面 / 遮盖层 / 工具条）：遮盖层平时 isEnabled=false、
  writeMode 关着，触摸照旧落到下面的卷面上，滚动与点题都不受影响。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/FbPage">

    <com.lytree.qbank.ui.FbTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 卷面容器：白底通铺到屏幕底边，底部让出系统导航条（代码里 applyNavBarBottomPadding） -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fb_sheet_bg">

        <!-- 多题连续卷面：与答题页的 questionList 同一份写法（通铺、无外边距） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/questionList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/fb_sheet_bg"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/fb_space_24"
            android:scrollbars="none" />

        <!-- 单题浏览：左右滑动切题（与答题页同一个 ViewPager2 容器，默认隐藏） -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/fb_sheet_bg"
            android:visibility="gone" />

        <!-- ===== 弹出材料：就地左右分屏（左材料 / 右整组题，中间手柄可左右拖动） =====
             与答题页同一份版式与同一个控制器（SplitPaneController）：解析页只是右栏的卡片
             多出答案 / 解析块，分屏本身的手感（比例记忆、可拖、可收起、可再弹整页）完全一致。 -->
        <LinearLayout
            android:id="@+id/splitBody"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- 左栏：材料，可收起（weight 1000 = 与右栏按比例分） -->
            <LinearLayout
                android:id="@+id/splitLeftPane"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="400"
                android:background="@color/fb_bar_bg"
                android:orientation="vertical"
                android:paddingStart="@dimen/fb_space_12"
                android:paddingTop="@dimen/fb_space_12"
                android:paddingEnd="@dimen/fb_space_12">

                <!-- 第一行：材料标签 + 组内进度。按钮放到第二行——左栏只有 40% 宽，
                     四个元素塞一行时「收起材料」会被挤出可视区。与答题页同一份结构。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSplitTag"
                        style="@style/FbTag"
                        android:text="@string/tag_material" />

                    <TextView
                        android:id="@+id/tvSplitProgress"
                        style="@style/FbCaption"
                        android:layout_marginStart="@dimen/fb_space_8" />
                </LinearLayout>

                <!-- 第二行：弹出整页看 / 收起材料，右对齐 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fb_space_4"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <!-- 左栏窄，表格 / 图表看不全时弹到整页看 -->
                    <LinearLayout
                        android:id="@+id/btnSplitExpand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/fb_space_4">

                        <ImageView
                            android:layout_width="@dimen/fb_icon_sm_size"
                            android:layout_height="@dimen/fb_icon_sm_size"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_fb_material_expand"
                            android:tint="@color/fb_text_meta" />

                        <TextView
                            style="@style/FbCaption"
                            android:layout_marginStart="@dimen/fb_space_4"
                            android:text="@string/material_pop_out" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnSplitCollapse"
                        style="@style/FbCaption"
                        android:layout_marginStart="@dimen/fb_space_8"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/fb_space_4"
                        android:text="@string/material_collapse" />
                </LinearLayout>

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/splitMaterialScroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/fb_space_8"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/splitMaterialContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>

            <!-- 中缝：整条都是热区，左右拖动改两栏占比；grip 只是个视觉小竖条 -->
            <FrameLayout
                android:id="@+id/splitHandle"
                android:layout_width="14dp"
                android:layout_height="match_parent">

                <View
                    android:id="@+id/splitHandleBar"
                    android:layout_width="4dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_fb_drag_bar" />
            </FrameLayout>

            <!-- 右栏：这一组材料对应的整组小题，铺成一条连续卷面（运行时放入按组分页的分页器） -->
            <FrameLayout
                android:id="@+id/splitQuestionPane"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="600" />
        </LinearLayout>

        <!-- 遮盖层（可写）：笔迹按「本条记录 + 题目」存取，答题时画的圈回来看解析还在 -->
        <com.lytree.qbank.ui.InkOverlay
            android:id="@+id/inkOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 写画工具条：与答题页 / 分屏页同一份，进写画模式才出现 -->
        <include
            android:id="@+id/inkBar"
            layout="@layout/view_fb_ink_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fb_ink_bar_h"
            android:layout_gravity="top" />

        <!-- ===== 更多（字号 / 日夜） =====
             答题页的这些显示设置放在「更多」面板里；解析页不给作答专属项（自动下一题 / 练习模式 /
             导入答案），只留显示相关的两项，档位与答题页共用一份偏好。 -->
        <LinearLayout
            android:id="@+id/morePanel"
            android:layout_width="178dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="@dimen/fb_space_8"
            android:background="@drawable/bg_fb_panel"
            android:elevation="10dp"
            android:orientation="vertical"
            android:paddingStart="@dimen/fb_space_16"
            android:paddingTop="@dimen/fb_space_12"
            android:paddingEnd="@dimen/fb_space_16"
            android:paddingBottom="@dimen/fb_space_12"
            android:visibility="gone">

            <!-- 字号：小 / 中 / 大 -->
            <LinearLayout
                android:id="@+id/rowFontSize"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnFontSmall"
                    style="@style/FbFontAa"
                    android:text="Aa"
                    android:textSize="@dimen/fb_text_body_size" />

                <TextView
                    android:id="@+id/btnFontMedium"
                    style="@style/FbFontAa"
                    android:text="Aa"
                    android:textSize="@dimen/fb_text_bar_title" />

                <TextView
                    android:id="@+id/btnFontLarge"
                    style="@style/FbFontAa"
                    android:text="Aa"
                    android:textSize="@dimen/fb_text_page_title" />
            </LinearLayout>

            <!-- 日间 / 夜间 -->
            <LinearLayout
                android:id="@+id/rowDayNight"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="@dimen/fb_space_8"
                android:background="@drawable/bg_fb_segment_track"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/btnDay"
                    style="@style/FbSegmentPill"
                    android:text="@string/mode_day" />

                <TextView
                    android:id="@+id/btnNight"
                    style="@style/FbSegmentPill"
                    android:text="@string/mode_night" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
