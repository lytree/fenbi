<?xml version="1.0" encoding="utf-8"?>
<!-- 成绩报告：统一标题栏 + 成绩卡 + 分模块正确率 + 逐题解析入口（解析本身在 activity_analysis） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/FbPage">

    <com.lytree.qbank.ui.FbTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            style="@style/FbPageColumn"
            android:paddingTop="@dimen/fb_space_16"
            android:paddingBottom="@dimen/fb_space_32">

            <!-- 缺少标准答案时的提示条：补完答案会按已有作答重判 -->
            <TextView
                android:id="@+id/tvPendingHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/fb_space_12"
                android:background="@drawable/bg_fb_note"
                android:lineSpacingExtra="3dp"
                android:padding="@dimen/fb_space_12"
                android:textColor="@color/fb_text_tertiary"
                android:textSize="@dimen/fb_text_body_sm"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                style="@style/FbCard"
                android:gravity="center_horizontal"
                android:paddingTop="@dimen/fb_space_24"
                android:paddingBottom="@dimen/fb_space_4">

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/fb_primary"
                    android:textSize="@dimen/fb_text_display"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFull"
                    style="@style/FbItemSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fb_space_4" />

                <View
                    style="@style/FbDivider"
                    android:layout_marginTop="@dimen/fb_space_20" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/fb_space_12"
                    android:paddingBottom="@dimen/fb_space_12">

                    <TextView
                        android:id="@+id/tvCorrectRate"
                        style="@style/FbStatCell" />

                    <TextView
                        android:id="@+id/tvRight"
                        style="@style/FbStatCell" />

                    <TextView
                        android:id="@+id/tvWrong"
                        style="@style/FbStatCell" />

                    <TextView
                        android:id="@+id/tvTime"
                        style="@style/FbStatCell" />
                </LinearLayout>
            </LinearLayout>

            <!-- 分模块正确率：按题目「科目/知识点」聚合，定位薄弱模块（对齐粉笔练习报告） -->
            <LinearLayout
                android:id="@+id/subjectStatsCard"
                style="@style/FbCard"
                android:layout_marginTop="@dimen/fb_card_gap_v"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvSubjectTitle"
                    style="@style/FbGroupTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/report_subject_title" />

                <LinearLayout
                    android:id="@+id/subjectStatsBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fb_space_8"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 全部题目：题号按判分状态上色，点题号直接进解析并翻到那一题 -->
            <TextView
                style="@style/FbSectionTitle"
                android:layout_marginTop="@dimen/fb_section_gap"
                android:text="@string/report_all_questions" />

            <LinearLayout
                android:id="@+id/cardNumbers"
                style="@style/FbCard"
                android:layout_marginTop="@dimen/fb_card_gap_v">

                <!-- 图例：只有本次出现过的状态才给（全对就没有「答错」） -->
                <LinearLayout
                    android:id="@+id/legendRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/gridNumbers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fb_space_8"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <TextView
                    style="@style/FbBodySm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fb_space_8"
                    android:text="@string/report_numbers_hint"
                    android:textColor="@color/fb_text_meta" />
            </LinearLayout>

            <!-- 两个入口：错题解析 / 全部解析，同一页、同一套题卡，只是档位不同 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fb_space_16"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWrongAnalysis"
                    style="@style/FbGhostButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/report_enter_wrong" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAllAnalysis"
                    style="@style/FbPrimaryButton"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/fb_space_12"
                    android:layout_weight="1"
                    android:text="@string/report_enter_all" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
