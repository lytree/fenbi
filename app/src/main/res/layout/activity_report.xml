<?xml version="1.0" encoding="utf-8"?>
<!-- 成绩报告：统一标题栏 + 成绩卡 + 分模块正确率 + 全部题目对错一览 + 解析入口 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/FbPage">

    <com.lytree.qbank.ui.FbTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            style="@style/FbPageColumn"
            android:paddingTop="@dimen/fb_space_16"
            android:paddingBottom="@dimen/fb_space_32">

            <!-- 缺少标准答案时的提示条：补完答案会按已有作答重判 -->
            <TextView
                android:id="@+id/tvPendingHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/fb_space_12"
                android:background="@drawable/bg_fb_note"
                android:lineSpacingExtra="3dp"
                android:padding="@dimen/fb_space_12"
                android:textColor="@color/fb_text_tertiary"
                android:textSize="@dimen/fb_text_body_sm"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                style="@style/FbCard"
                android:gravity="center_horizontal"
                android:paddingTop="@dimen/fb_space_24"
                android:paddingBottom="@dimen/fb_space_4">

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/fb_primary"
                    android:textSize="@dimen/fb_text_display"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFull"
                    style="@style/FbItemSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fb_space_4" />

                <View
                    style="@style/FbDivider"
                    android:layout_marginTop="@dimen/fb_space_20" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/fb_space_12"
                    android:paddingBottom="@dimen/fb_space_12">

                    <TextView
                        android:id="@+id/tvCorrectRate"
                        style="@style/FbStatCell" />

                    <TextView
                        android:id="@+id/tvRight"
                        style="@style/FbStatCell" />

                    <TextView
                        android:id="@+id/tvWrong"
                        style="@style/FbStatCell" />

                    <TextView
                        android:id="@+id/tvTime"
                        style="@style/FbStatCell" />
                </LinearLayout>
            </LinearLayout>

            <!-- 分模块正确率：按题目「科目/知识点」聚合，定位薄弱模块（对齐粉笔练习报告） -->
            <LinearLayout
                android:id="@+id/subjectStatsCard"
                style="@style/FbCard"
                android:layout_marginTop="@dimen/fb_card_gap_v"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvSubjectTitle"
                    style="@style/FbGroupTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/report_subject_title" />

                <LinearLayout
                    android:id="@+id/subjectStatsBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fb_space_8"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 全部题目：只给对错一览（对=绿 / 错=红 / 未答=灰），解析收进下面的两个入口 -->
            <TextView
                android:id="@+id/tvOverviewTitle"
                style="@style/FbSectionTitle"
                android:layout_marginTop="@dimen/fb_section_gap"
                android:text="@string/report_overview_title" />

            <LinearLayout
                style="@style/FbCard"
                android:layout_marginTop="@dimen/fb_card_gap_v">

                <!-- 图例按实际出现的状态动态生成（最多一行 3 个） -->
                <LinearLayout
                    android:id="@+id/legendBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fb_space_8"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/tvOverviewHint"
                    style="@style/FbCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fb_space_8"
                    android:text="@string/report_overview_hint" />
            </LinearLayout>

            <!-- 解析入口：同一套解析页，左=只翻错题 / 右=翻整卷 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fb_card_gap_v"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStepAnalysis"
                    style="@style/FbGhostButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/report_action_wrong_analysis" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAllAnalysis"
                    style="@style/FbPrimaryButton"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/fb_space_12"
                    android:layout_weight="1"
                    android:text="@string/report_action_all_analysis" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
