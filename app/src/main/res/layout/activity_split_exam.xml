<?xml version="1.0" encoding="utf-8"?>
<!-- 资料分析分屏（对齐粉笔真机）：顶栏只留返回 + 计时，左栏材料白底整栏，右栏题目白底通铺 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fb_sheet_bg">

    <!-- 顶部栏：与其他页面同一套 FbTitleBar，右侧挂题号 -->
    <com.lytree.qbank.ui.FbTitleBar
        android:id="@+id/titleBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/topDivider"
        style="@style/FbDivider"
        android:layout_width="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleBar" />

    <!-- ===== 左栏：材料 ===== -->
    <LinearLayout
        android:id="@+id/leftPane"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/fb_sheet_bg"
        android:orientation="vertical"
        android:padding="@dimen/fb_space_16"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toStartOf="@id/splitDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topDivider"
        app:layout_constraintWidth_percent="0.5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/FbTag"
                android:text="@string/tag_material" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 左栏很窄，图 / 表看不全时可以弹出来看 -->
            <LinearLayout
                android:id="@+id/btnMaterialExpand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/fb_space_4">

                <ImageView
                    android:layout_width="@dimen/fb_icon_sm_size"
                    android:layout_height="@dimen/fb_icon_sm_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_fb_material_expand"
                    android:tint="@color/fb_text_meta" />

                <TextView
                    style="@style/FbCaption"
                    android:layout_marginStart="@dimen/fb_space_4"
                    android:text="@string/material_pop_out" />
            </LinearLayout>
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/materialScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/fb_space_8"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/materialContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- 分隔线 + 拖动手柄 -->
    <View
        android:id="@+id/splitDivider"
        android:layout_width="0.5dp"
        android:layout_height="0dp"
        android:background="@color/fb_table_line"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toStartOf="@id/rightPane"
        app:layout_constraintStart_toEndOf="@id/leftPane"
        app:layout_constraintTop_toBottomOf="@id/topDivider" />

    <View
        android:id="@+id/splitHandle"
        android:layout_width="16dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_fb_split_handle"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="@id/splitDivider"
        app:layout_constraintStart_toStartOf="@id/splitDivider"
        app:layout_constraintTop_toBottomOf="@id/topDivider" />

    <!-- ===== 右栏：题目 ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/rightPane"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/splitDivider"
        app:layout_constraintTop_toBottomOf="@id/topDivider">

        <LinearLayout
            android:id="@+id/questionList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/fb_content_padding_h"
            android:paddingTop="@dimen/fb_space_8"
            android:paddingEnd="@dimen/fb_content_padding_h" />
    </androidx.core.widget.NestedScrollView>

    <!-- 遮盖层（可写，覆盖全屏，两栏都能标）：常驻可见，退出写画后笔迹仍留在原处 -->
    <com.lytree.qbank.ui.InkOverlay
        android:id="@+id/inkOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topDivider" />

    <!-- ===== 底部操作区（全站统一底栏：白底 + 上方 0.5dp 分割线 + 上下 10dp） ===== -->
    <View
        android:id="@+id/bottomDivider"
        style="@style/FbDivider"
        android:layout_width="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/bottomBar"
        style="@style/FbBottomBar"
        android:layout_width="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnInk"
            android:layout_width="0dp"
            android:layout_height="@dimen/fb_btn_h"
            android:layout_weight="1"
            android:background="@drawable/bg_fb_btn_ghost"
            android:gravity="center"
            android:text="@string/action_ink"
            android:textColor="@color/fb_primary"
            android:textSize="@dimen/fb_btn_text_size" />

        <TextView
            android:id="@+id/btnCard"
            android:layout_width="0dp"
            android:layout_height="@dimen/fb_btn_h"
            android:layout_marginStart="@dimen/fb_space_8"
            android:layout_marginEnd="@dimen/fb_space_8"
            android:layout_weight="1"
            android:background="@drawable/bg_fb_btn_ghost"
            android:gravity="center"
            android:text="@string/action_answer_card"
            android:textColor="@color/fb_primary"
            android:textSize="@dimen/fb_btn_text_size" />

        <TextView
            android:id="@+id/btnSubmit"
            android:layout_width="0dp"
            android:layout_height="@dimen/fb_btn_h"
            android:layout_weight="1"
            android:background="@drawable/bg_fb_btn_primary"
            android:gravity="center"
            android:text="@string/action_submit"
            android:textColor="@color/fb_text_on_primary"
            android:textSize="@dimen/fb_btn_text_size" />
    </LinearLayout>

    <!-- 悬浮：遮盖层工具条（撤销 / 清空 / 遮盖档位 / 标记 / 完成） -->
    <LinearLayout
        android:id="@+id/inkBar"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/fb_bar_h"
        android:layout_marginEnd="@dimen/fb_space_16"
        android:layout_marginBottom="70dp"
        android:background="@drawable/bg_fb_action"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/fb_space_4"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnInkUndo"
            style="@style/FbInkAction"
            android:text="@string/action_undo"
            android:textColor="@color/fb_text_primary" />

        <TextView
            android:id="@+id/btnInkClear"
            style="@style/FbInkAction"
            android:text="@string/action_clear_ink"
            android:textColor="@color/fb_danger" />

        <!-- 笔色：实心圆就是当前笔色，点一下换下一色 -->
        <View
            android:id="@+id/btnInkColor"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="@dimen/fb_space_8"
            android:background="@drawable/bg_fb_ink_color"
            android:contentDescription="@string/action_ink_color" />

        <TextView
            android:id="@+id/btnInkShade"
            style="@style/FbInkAction"
            tools:text="遮盖·浅" />

        <TextView
            android:id="@+id/btnInkMark"
            style="@style/FbInkAction"
            tools:text="标记" />

        <TextView
            android:id="@+id/btnInkDone"
            style="@style/FbInkAction"
            android:text="@string/action_done"
            android:textColor="@color/fb_primary" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
