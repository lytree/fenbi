<?xml version="1.0" encoding="utf-8"?>
<!-- 资料分析分屏：左侧材料（可滚动），右侧题目列表 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fb_page_bg">

    <!-- 顶部栏：与其他页面同一套 FbTitleBar，右侧挂题号 -->
    <com.lytree.qbank.ui.FbTitleBar
        android:id="@+id/titleBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/topDivider"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:background="@color/divider"
        app:layout_constraintTop_toBottomOf="@id/titleBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== 左栏：材料 ===== -->
    <LinearLayout
        android:id="@+id/leftPane"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/fb_split_bg"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/topDivider"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/splitDivider"
        app:layout_constraintWidth_percent="0.5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_fb_material_tag"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="@string/tag_material"
                android:textColor="@color/fb_blue_ink"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 左栏很窄，图 / 表看不全时可以弹出来看 -->
            <LinearLayout
                android:id="@+id/btnMaterialExpand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="2dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_fb_material_expand"
                    android:tint="@color/fb_text_meta" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:includeFontPadding="false"
                    android:text="@string/material_pop_out"
                    android:textColor="@color/fb_text_meta"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/materialScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/materialContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- 分隔线 + 拖动手柄 -->
    <View
        android:id="@+id/splitDivider"
        android:layout_width="0.5dp"
        android:layout_height="0dp"
        android:background="@color/fb_table_line"
        app:layout_constraintTop_toBottomOf="@id/topDivider"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toEndOf="@id/leftPane"
        app:layout_constraintEnd_toStartOf="@id/rightPane" />

    <View
        android:id="@+id/splitHandle"
        android:layout_width="16dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_fb_split_handle"
        app:layout_constraintTop_toBottomOf="@id/topDivider"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="@id/splitDivider"
        app:layout_constraintEnd_toEndOf="@id/splitDivider" />

    <!-- ===== 右栏：题目 ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/rightPane"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topDivider"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toEndOf="@id/splitDivider"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/questionList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />
    </androidx.core.widget.NestedScrollView>

    <!-- 遮盖层（可写，覆盖全屏，两栏都能标）：常驻可见，退出写画后笔迹仍留在原处 -->
    <com.lytree.qbank.ui.InkOverlay
        android:id="@+id/inkOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topDivider"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== 底部 ===== -->
    <!-- 底部操作区 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/fb_bar_bg"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnInk"
            android:layout_width="0dp"
            android:layout_height="@dimen/fb_btn_h"
            android:layout_weight="1"
            android:background="@drawable/bg_fb_btn_ghost"
            android:gravity="center"
            android:text="@string/action_ink"
            android:textColor="@color/fb_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnCard"
            android:layout_width="0dp"
            android:layout_height="@dimen/fb_btn_h"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_fb_btn_ghost"
            android:gravity="center"
            android:text="@string/action_answer_card"
            android:textColor="@color/fb_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnSubmit"
            android:layout_width="0dp"
            android:layout_height="@dimen/fb_btn_h"
            android:layout_weight="1"
            android:background="@drawable/bg_fb_btn_primary"
            android:gravity="center"
            android:text="@string/action_submit"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 悬浮：遮盖层工具条（撤销 / 清空 / 遮盖档位 / 标记 / 完成） -->
    <LinearLayout
        android:id="@+id/inkBar"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="70dp"
        android:background="@drawable/bg_fb_action"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnInkUndo"
            style="@style/FbInkAction"
            android:text="@string/action_undo"
            android:textColor="@color/fb_text_primary" />

        <TextView
            android:id="@+id/btnInkClear"
            style="@style/FbInkAction"
            android:text="@string/action_clear_ink"
            android:textColor="@color/fb_red" />

        <TextView
            android:id="@+id/btnInkShade"
            style="@style/FbInkAction"
            tools:text="遮盖·浅" />

        <TextView
            android:id="@+id/btnInkMark"
            style="@style/FbInkAction"
            tools:text="标记" />

        <TextView
            android:id="@+id/btnInkDone"
            style="@style/FbInkAction"
            android:text="@string/action_done"
            android:textColor="@color/fb_primary" />
    </LinearLayout>

    <View
        android:id="@+id/bottomDivider"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:background="@color/fb_divider"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
