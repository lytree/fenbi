<?xml version="1.0" encoding="utf-8"?>
<!--
  词库导入页：选文档 → 解析预览（词条 / 拼音 / 分类）→ 导入
  与试卷导入同一套版式，但只有「导入」一条路，没有卷名 / 限时那些题目专属选项。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fb_page_bg"
    android:orientation="vertical">

    <com.lytree.qbank.ui.FbTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===== 第一步：选文档 ===== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/pickPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/fb_page_pad"
                android:paddingTop="16dp"
                android:paddingEnd="@dimen/fb_page_pad"
                android:paddingBottom="20dp">

                <LinearLayout style="@style/FbCard">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/word_pick_title"
                        android:textColor="@color/fb_text_title"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/FbItemSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/word_pick_hint"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPick"
                        style="@style/FbPrimaryButton"
                        android:layout_width="match_parent"
                        android:layout_marginTop="18dp"
                        android:text="选择文档" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSample"
                        style="@style/FbTextButton"
                        android:layout_width="match_parent"
                        android:layout_marginTop="4dp"
                        android:text="载入示例词表（体验用）" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===== 第二步：解析结果 ===== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/resultPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/fb_page_pad"
                android:paddingTop="16dp"
                android:paddingEnd="@dimen/fb_page_pad"
                android:paddingBottom="20dp">

                <LinearLayout style="@style/FbCard">

                    <TextView
                        android:id="@+id/tvFile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/fb_text_title"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStat"
                        style="@style/FbItemSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp" />

                    <TextView
                        android:id="@+id/tvGuessed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/partial"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    style="@style/FbCard"
                    android:layout_marginTop="@dimen/fb_card_gap_v">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/word_import_replace"
                                android:textColor="@color/fb_text_title"
                                android:textSize="14sp" />

                            <TextView
                                style="@style/FbItemSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/word_import_replace_hint"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.lytree.qbank.ui.FbSwitchView
                            android:id="@+id/switchReplace"
                            android:layout_width="38dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="12dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="词条预览"
                        android:textColor="@color/fb_text_title"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAll"
                        style="@style/FbTextButton"
                        android:layout_width="wrap_content"
                        android:text="全选 / 反选" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/tvIssuesTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="2dp"
                    android:text="解析提示"
                    android:textColor="@color/fb_text_title"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listIssues"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <View
        android:id="@+id/bottomDivider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/fb_divider"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fb_bar_bg"
        android:paddingStart="@dimen/fb_page_pad"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/fb_page_pad"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImport"
            style="@style/FbPrimaryButton"
            android:layout_width="match_parent"
            android:text="@string/word_import_confirm" />
    </FrameLayout>
</LinearLayout>
