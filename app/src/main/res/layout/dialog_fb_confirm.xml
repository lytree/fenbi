<?xml version="1.0" encoding="utf-8"?>
<!--
  确认弹窗（全站统一）：12dp 圆角白卡 + 居中正文 15sp + 两个等宽胶囊按钮
  取消 = 淡蓝底蓝字 / 确定 = 主蓝白字，按钮高 42dp
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/FbDialogCard">

    <TextView
        android:id="@+id/tvMessage"
        style="@style/FbDialogMessage"
        tools:text="您当前还有题目未完成作答，且本系统不支持二次提交。提交后将无法补充录入剩余题目答案，确定交卷吗？" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_space_24"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            style="@style/FbDialogAction"
            android:text="@string/action_cancel" />

        <TextView
            android:id="@+id/btnOk"
            style="@style/FbDialogActionPrimary"
            android:layout_marginStart="@dimen/fb_space_12"
            android:text="@string/action_confirm" />
    </LinearLayout>
</LinearLayout>
