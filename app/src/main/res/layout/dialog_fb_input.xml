<?xml version="1.0" encoding="utf-8"?>
<!-- 输入弹窗（笔记 / 批量粘贴）：白卡 + 多行输入框 + 两个等宽胶囊按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/FbDialogCard">

    <TextView
        android:id="@+id/tvTitle"
        style="@style/FbDialogTitle"
        android:visibility="gone" />

    <EditText
        android:id="@+id/etInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_space_12"
        android:background="@drawable/bg_fb_answer_input"
        android:gravity="top|start"
        android:importantForAutofill="no"
        android:inputType="textMultiLine"
        android:minHeight="96dp"
        android:padding="@dimen/fb_space_12"
        android:textColor="@color/fb_text_title"
        android:textColorHint="@color/fb_text_hint"
        android:textSize="@dimen/fb_text_body_size" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_space_20"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            style="@style/FbDialogAction"
            android:text="@string/action_cancel" />

        <TextView
            android:id="@+id/btnOk"
            style="@style/FbDialogActionPrimary"
            android:layout_marginStart="@dimen/fb_space_12"
            android:text="@string/action_confirm" />
    </LinearLayout>
</LinearLayout>
