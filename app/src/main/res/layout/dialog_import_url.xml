<?xml version="1.0" encoding="utf-8"?>
<!--
  从链接导入弹窗：白卡 + 链接输入框 + 下载进度，确认后先下载再出预览
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/FbDialogCard">

    <TextView
        style="@style/FbDialogTitle"
        android:text="@string/import_link_title" />

    <TextView
        style="@style/FbBodySm"
        android:layout_marginTop="@dimen/fb_space_4"
        android:text="@string/import_link_hint" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayoutUrl"
        style="@style/FbInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_space_12"
        android:hint="@string/import_link_placeholder">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputUrl"
            style="@style/FbEditText"
            android:inputType="textUri"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="@dimen/fb_space_12"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvStatus"
        style="@style/FbCaption"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/fb_space_8"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_space_20"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            style="@style/FbDialogAction"
            android:text="@string/action_cancel" />

        <TextView
            android:id="@+id/btnOk"
            style="@style/FbDialogActionPrimary"
            android:layout_marginStart="@dimen/fb_space_12"
            android:text="@string/import_link_download" />
    </LinearLayout>
</LinearLayout>
