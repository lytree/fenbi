<?xml version="1.0" encoding="utf-8"?>
<!--
  导图查看（全屏）：一页书一张图，节点连线画在画布上，双指缩放 / 拖动 / 点节点折叠。
  底部一排是视角与展开控制；有「内涵连线」的主题多一颗配对按钮。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/FbPage"
    android:orientation="vertical">

    <com.lytree.qbank.ui.FbTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvHint"
        style="@style/FbCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/fb_page_pad"
        android:paddingTop="@dimen/fb_space_4"
        android:paddingEnd="@dimen/fb_page_pad"
        android:text="@string/mindmap_graph_hint" />

    <com.lytree.qbank.ui.recite.MindMapGraphView
        android:id="@+id/graph"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View style="@style/FbDivider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/fb_page_pad"
        android:paddingTop="@dimen/fb_space_8"
        android:paddingEnd="@dimen/fb_page_pad"
        android:paddingBottom="@dimen/fb_space_8">

        <TextView
            android:id="@+id/btnFit"
            style="@style/FbGraphAction"
            android:text="@string/mindmap_graph_fit" />

        <TextView
            android:id="@+id/btnExpand"
            style="@style/FbGraphAction"
            android:text="@string/mindmap_graph_expand" />

        <TextView
            android:id="@+id/btnCollapse"
            style="@style/FbGraphAction"
            android:text="@string/mindmap_graph_collapse" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnPairs"
            style="@style/FbGraphAction"
            android:textColor="@color/fb_primary"
            android:text="@string/mindmap_pair_section"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
