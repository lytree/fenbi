<?xml version="1.0" encoding="utf-8"?>
<!-- 考点详情：完整题干（答案已填好）+ 记忆提示 + 来源 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/FbDialogCard">

    <TextView
        android:id="@+id/tvDetailTitle"
        style="@style/FbCaption"
        android:layout_width="match_parent"
        tools:text="1 · 四中全会·十五五" />

    <TextView
        android:id="@+id/tvDetailText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_space_8"
        android:lineSpacingExtra="7dp"
        android:textColor="@color/fb_text_primary"
        android:textSize="@dimen/fb_text_bar_title"
        tools:text="1.党的二十届四中全会审议通过了《中共中央关于制定国民经济和社会发展第十五个五年规划的建议》。" />

    <TextView
        android:id="@+id/tvDetailNoteLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_space_20"
        android:includeFontPadding="false"
        android:text="@string/recite_detail_note"
        android:textColor="@color/fb_primary"
        android:textSize="@dimen/fb_text_item_sub"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDetailNote"
        style="@style/FbBodySm"
        android:layout_marginTop="@dimen/fb_space_4"
        tools:text="简称“十五五”规划建议，2025 年 10 月 23 日通过。" />

    <TextView
        android:id="@+id/tvDetailSource"
        style="@style/FbCaption"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/fb_space_12"
        android:textColor="@color/fb_text_hint"
        tools:text="来源：二十届四中全会公报" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDetailClose"
        style="@style/FbPrimaryButton"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/fb_space_20"
        android:text="@string/action_close" />
</LinearLayout>
