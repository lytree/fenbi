<?xml version="1.0" encoding="utf-8"?>
<!--
  备份与恢复：设置页的二级页。
  版式沿用设置页——分组标题 + 白卡，行内左文右值，可点行右侧一枚折角箭头。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/FbPage">

    <com.lytree.qbank.ui.FbTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 备份/恢复进行中：细进度条 + 一句状态，做完自动收起 -->
    <LinearLayout
        android:id="@+id/progressBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/fb_page_pad"
        android:paddingTop="@dimen/fb_space_8"
        android:paddingEnd="@dimen/fb_page_pad"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100" />

        <TextView
            android:id="@+id/tvProgress"
            style="@style/FbCaption"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/fb_space_8"
            tools:text="打包中…" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            style="@style/FbPageColumn"
            android:paddingBottom="@dimen/fb_space_32">

            <TextView
                style="@style/FbGroupTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fb_space_20"
                android:layout_marginBottom="@dimen/fb_space_8"
                android:text="备份" />

            <LinearLayout style="@style/FbCard">

                <TextView
                    style="@style/FbRowTitle"
                    android:text="上次备份" />

                <TextView
                    android:id="@+id/tvLastBackup"
                    style="@style/FbRowSub"
                    tools:text="2026-10-29 22:30 · 12.4 MB" />

                <View style="@style/FbDividerInset" />

                <LinearLayout
                    android:id="@+id/rowBackupNow"
                    style="@style/FbSwitchRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FbRowTitle"
                            android:text="立即备份" />

                        <TextView
                            style="@style/FbRowSub"
                            android:text="试卷、作答记录、手写笔迹、材料配图一次打包" />
                    </LinearLayout>

                    <TextView
                        style="@style/FbRowArrow"
                        android:text="›" />
                </LinearLayout>

                <View style="@style/FbDividerInset" />

                <LinearLayout
                    android:id="@+id/rowShare"
                    style="@style/FbSwitchRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FbRowTitle"
                            android:text="分享备份包" />

                        <TextView
                            style="@style/FbRowSub"
                            android:text="直接存进百度网盘 / 天翼云盘 / 微信，也能发给自己" />
                    </LinearLayout>

                    <TextView
                        style="@style/FbRowArrow"
                        android:text="›" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/FbGroupTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fb_section_gap"
                android:layout_marginBottom="@dimen/fb_space_8"
                android:text="恢复" />

            <LinearLayout style="@style/FbCard">

                <LinearLayout
                    android:id="@+id/rowRestoreFile"
                    style="@style/FbSwitchRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FbRowTitle"
                            android:text="从备份文件恢复" />

                        <TextView
                            style="@style/FbRowSub"
                            android:text="选一份 qbank-backup-*.zip；从网盘下载下来的那份也行" />
                    </LinearLayout>

                    <TextView
                        style="@style/FbRowArrow"
                        android:text="›" />
                </LinearLayout>

                <View style="@style/FbDividerInset" />

                <LinearLayout
                    android:id="@+id/rowRestoreCloud"
                    style="@style/FbSwitchRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FbRowTitle"
                            android:text="从云端恢复" />

                        <TextView
                            android:id="@+id/tvRestoreCloudSub"
                            style="@style/FbRowSub"
                            android:text="先配好下面的 WebDAV 才能用" />
                    </LinearLayout>

                    <TextView
                        style="@style/FbRowArrow"
                        android:text="›" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/FbGroupTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fb_section_gap"
                android:layout_marginBottom="@dimen/fb_space_8"
                android:text="云端同步（可选）" />

            <LinearLayout style="@style/FbCard">

                <TextView
                    style="@style/FbRowTitle"
                    android:text="WebDAV 网盘" />

                <TextView
                    style="@style/FbRowSub"
                    android:text="坚果云 / Nextcloud / 群晖 / InfiniCLOUD。百度网盘与天翼云盘的开放接口不对个人开放，用上面的「分享」把它存进去即可。" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FbInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fb_space_12"
                    android:hint="地址，如 https://dav.jianguoyun.com/dav/">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputUrl"
                        style="@style/FbEditText"
                        android:inputType="textUri"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FbInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fb_space_8"
                    android:hint="账号（邮箱）">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputUser"
                        style="@style/FbEditText"
                        android:inputType="textEmailAddress"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FbInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fb_space_8"
                    android:hint="应用密码（不是登录密码）">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputPass"
                        style="@style/FbEditText"
                        android:inputType="textPassword"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FbInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fb_space_8"
                    android:hint="存哪个目录（默认 qbank）">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputDir"
                        style="@style/FbEditText"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fb_space_12"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTest"
                        style="@style/FbGhostButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="测试连接" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUploadNow"
                        style="@style/FbGhostButton"
                        android:layout_width="0dp"
                        android:layout_marginStart="@dimen/fb_space_8"
                        android:layout_weight="1"
                        android:text="备份到云端" />
                </LinearLayout>

                <View
                    style="@style/FbDividerInset"
                    android:layout_marginTop="@dimen/fb_space_12" />

                <LinearLayout style="@style/FbSwitchRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FbRowTitle"
                            android:text="每天自动备份到云端" />

                        <TextView
                            android:id="@+id/tvAutoSub"
                            style="@style/FbRowSub"
                            android:text="夜间闲时跑一次；没配 WebDAV 时不生效" />
                    </LinearLayout>

                    <com.lytree.qbank.ui.FbSwitchView
                        android:id="@+id/swAuto"
                        style="@style/FbSwitch" />
                </LinearLayout>

                <View style="@style/FbDividerInset" />

                <LinearLayout
                    android:id="@+id/rowKeep"
                    style="@style/FbSwitchRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FbRowTitle"
                            android:text="云端保留份数" />

                        <TextView
                            android:id="@+id/tvKeep"
                            style="@style/FbRowSub"
                            android:text="7 份，超出自动删最旧的" />
                    </LinearLayout>

                    <TextView
                        style="@style/FbRowArrow"
                        android:text="›" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/FbRowSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fb_space_16"
                android:text="备份包里的内容：试卷与题目、作答记录与成绩、手写笔迹与笔记、背诵掌握进度、判题规则、材料配图。恢复会把当前数据整个换成包里的那份，旧库会留一份 .before-restore 兜底。" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
