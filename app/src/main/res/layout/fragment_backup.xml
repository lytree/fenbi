<?xml version="1.0" encoding="utf-8"?>
<!--
  备份与恢复：设置页的二级页。
  版式沿用设置页——分组标题 + 白卡，行内左文右值，可点行右侧一枚折角箭头。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/FbPage">

    <com.lytree.qbank.ui.FbTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 备份/恢复进行中：细进度条 + 一句状态，做完自动收起 -->
    <LinearLayout
        android:id="@+id/progressBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/fb_page_pad"
        android:paddingTop="@dimen/fb_space_8"
        android:paddingEnd="@dimen/fb_page_pad"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100" />

        <TextView
            android:id="@+id/tvProgress"
            style="@style/FbCaption"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/fb_space_8"
            tools:text="打包中…" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            style="@style/FbPageColumn"
            android:paddingBottom="@dimen/fb_space_32">

            <TextView
                style="@style/FbGroupTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fb_space_20"
                android:layout_marginBottom="@dimen/fb_space_8"
                android:text="备份" />

            <LinearLayout style="@style/FbCard">

                <TextView
                    style="@style/FbRowTitle"
                    android:text="上次备份" />

                <TextView
                    android:id="@+id/tvLastBackup"
                    style="@style/FbRowSub"
                    tools:text="2026-10-29 22:30 · 12.4 MB" />

                <View style="@style/FbDividerInset" />

                <LinearLayout
                    android:id="@+id/rowBackupNow"
                    style="@style/FbSwitchRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FbRowTitle"
                            android:text="立即备份" />

                        <TextView
                            style="@style/FbRowSub"
                            android:text="试卷、作答记录、手写笔迹、材料配图一次打包" />
                    </LinearLayout>

                    <TextView
                        style="@style/FbRowArrow"
                        android:text="›" />
                </LinearLayout>

                <View style="@style/FbDividerInset" />

                <LinearLayout
                    android:id="@+id/rowShare"
                    style="@style/FbSwitchRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FbRowTitle"
                            android:text="分享备份包" />

                        <TextView
                            style="@style/FbRowSub"
                            android:text="直接存进百度网盘 / 天翼云盘 / 微信，也能发给自己" />
                    </LinearLayout>

                    <TextView
                        style="@style/FbRowArrow"
                        android:text="›" />
                </LinearLayout>

                <View style="@style/FbDividerInset" />

                <LinearLayout
                    android:id="@+id/rowHistory"
                    style="@style/FbSwitchRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FbRowTitle"
                            android:text="备份历史" />

                        <TextView
                            android:id="@+id/tvHistorySub"
                            style="@style/FbRowSub"
                            tools:text="共 6 条 · 最近 2026-11-21 21:43" />
                    </LinearLayout>

                    <TextView
                        style="@style/FbRowArrow"
                        android:text="›" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/FbGroupTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fb_section_gap"
                android:layout_marginBottom="@dimen/fb_space_8"
                android:text="恢复" />

            <!-- 恢复：直接把能恢复的备份列出来（行由 BackupFragment.renderRestore 动态铺），
                 末尾一行才是「从备份文件导入」。不再先点一行再弹层选，少一层点击 -->
            <LinearLayout style="@style/FbCard">

                <TextView
                    android:id="@+id/tvRestoreEmpty"
                    style="@style/FbRowSub"
                    android:text="还没有能恢复的备份：先备份一次，或用下面的「从备份文件导入」" />

                <LinearLayout
                    android:id="@+id/restoreBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <View
                    android:id="@+id/dividerImport"
                    style="@style/FbDividerInset" />

                <LinearLayout
                    android:id="@+id/rowImport"
                    style="@style/FbSwitchRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FbRowTitle"
                            android:text="从备份文件导入" />

                        <TextView
                            style="@style/FbRowSub"
                            android:text="选一份 qbank-backup-*.zip；从网盘下载下来的那份也行" />
                    </LinearLayout>

                    <TextView
                        style="@style/FbRowArrow"
                        android:text="›" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/FbRowSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fb_space_16"
                android:text="备份包里的内容：试卷与题目、作答记录与成绩、手写笔迹与笔记、背诵掌握进度、判题规则、材料配图。恢复会把当前数据整个换成包里的那份，旧库会留一份 .before-restore 兜底。" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
