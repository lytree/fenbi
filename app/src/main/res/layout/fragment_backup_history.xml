<?xml version="1.0" encoding="utf-8"?>
<!--
  备份历史：备份与恢复页的二级页。
  版式跟备份页一致——分组标签 + 白卡，行内左文右值。行由 BackupHistoryFragment 动态铺。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/FbPage">

    <com.lytree.qbank.ui.FbTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 恢复进行中的细进度条：跟备份页同一个外壳，状态文字在下面一行 -->
    <LinearLayout
        android:id="@+id/progressBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/fb_page_pad"
        android:paddingTop="@dimen/fb_space_8"
        android:paddingEnd="@dimen/fb_page_pad"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100" />

        <TextView
            android:id="@+id/tvProgress"
            style="@style/FbCaption"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/fb_space_8"
            tools:text="恢复中…" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            style="@style/FbPageColumn"
            android:paddingBottom="@dimen/fb_space_32">

            <TextView
                android:id="@+id/tvGroup"
                style="@style/FbGroupTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fb_space_20"
                android:layout_marginBottom="@dimen/fb_space_8"
                android:text="备份记录" />

            <LinearLayout style="@style/FbCard">

                <TextView
                    android:id="@+id/tvEmpty"
                    style="@style/FbRowSub"
                    android:text="还没有备份记录。回到上一页点「立即备份」，这里就会多一条。" />

                <LinearLayout
                    android:id="@+id/listBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                style="@style/FbRowSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fb_space_16"
                android:text="点一条可以恢复、分享或删掉这条记录。记录和备份包分开存：包被本地「只留 2 份」清掉了，这一条还在，点恢复时会告诉你找不回来。" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
