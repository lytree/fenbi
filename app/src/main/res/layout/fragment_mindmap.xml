<?xml version="1.0" encoding="utf-8"?>
<!--
  思维导图浏览页：顶部按书里的板块筛选，下面一个板块一个分组，一页导图一张卡
  与词库 / 政治 / 常识同一套页面骨架：页标题 + 三段切换 + 一行胶囊筛选
  内容来自 assets/recite_mindmap.json
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/FbPage">

    <com.lytree.qbank.ui.FbTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 词库 / 政治 / 常识 三段切换：导图挂在政治这一段下面，切走就回对应的页 -->
    <include
        android:id="@+id/librarySwitch"
        layout="@layout/view_library_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvIntro"
        style="@style/FbCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/fb_page_pad"
        android:paddingTop="2dp"
        android:paddingEnd="@dimen/fb_page_pad"
        android:paddingBottom="@dimen/fb_space_8"
        tools:text="共 10 个板块 36 个主题 · 点主题展开，点分支收起" />

    <HorizontalScrollView
        android:id="@+id/sectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="@dimen/fb_page_pad"
        android:paddingEnd="@dimen/fb_page_pad"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/sectionChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="@dimen/fb_space_8" />
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/fb_space_16"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/emptyText"
        style="@style/FbEmptyText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="@string/mindmap_empty"
        android:visibility="gone" />
</LinearLayout>
