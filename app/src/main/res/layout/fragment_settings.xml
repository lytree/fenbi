<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页：大标题 + 分组卡（行内左文右开关，行间 0.5dp 缩进分割线）
  版式统一：分组标题 13sp 灰、卡内 16dp、行高 52dp、说明 12sp 灰
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/FbPage">

    <com.lytree.qbank.ui.FbTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            style="@style/FbPageColumn"
            android:paddingBottom="@dimen/fb_space_32">

            <TextView
                style="@style/FbGroupTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fb_space_20"
                android:layout_marginBottom="@dimen/fb_space_8"
                android:text="判题规则" />

            <LinearLayout style="@style/FbCard">

                <LinearLayout style="@style/FbSwitchRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FbRowTitle"
                            android:text="多选题少选也给部分分" />

                        <TextView
                            style="@style/FbRowSub"
                            android:text="按选中比例给分，错选仍 0 分" />
                    </LinearLayout>

                    <com.lytree.qbank.ui.FbSwitchView
                        android:id="@+id/swMulti"
                        style="@style/FbSwitch" />
                </LinearLayout>

                <View style="@style/FbDividerInset" />

                <LinearLayout style="@style/FbSwitchRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FbRowTitle"
                            android:text="不定项少选给 50% 分" />

                        <TextView
                            style="@style/FbRowSub"
                            android:text="全对满分，错选 0 分" />
                    </LinearLayout>

                    <com.lytree.qbank.ui.FbSwitchView
                        android:id="@+id/swUncertain"
                        style="@style/FbSwitch" />
                </LinearLayout>

                <View style="@style/FbDividerInset" />

                <LinearLayout style="@style/FbSwitchRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FbRowTitle"
                            android:text="填空题漏填给部分分" />

                        <TextView
                            style="@style/FbRowSub"
                            android:text="逐空比对，忽略空白与标点" />
                    </LinearLayout>

                    <com.lytree.qbank.ui.FbSwitchView
                        android:id="@+id/swFill"
                        style="@style/FbSwitch" />
                </LinearLayout>

                <View style="@style/FbDividerInset" />

                <LinearLayout style="@style/FbSwitchRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FbRowTitle"
                            android:text="主观题按关键词命中给部分分" />

                        <TextView
                            style="@style/FbRowSub"
                            android:text="按「得分点」命中率计分" />
                    </LinearLayout>

                    <com.lytree.qbank.ui.FbSwitchView
                        android:id="@+id/swSubjective"
                        style="@style/FbSwitch" />
                </LinearLayout>

                <View style="@style/FbDividerInset" />

                <LinearLayout style="@style/FbSwitchRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FbRowTitle"
                            android:text="判断题兼容多种写法" />

                        <TextView
                            style="@style/FbRowSub"
                            android:text="对 / 错 / √ / × / T / F / Y / N" />
                    </LinearLayout>

                    <com.lytree.qbank.ui.FbSwitchView
                        android:id="@+id/swJudgeLenient"
                        style="@style/FbSwitch" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/FbGroupTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fb_section_gap"
                android:layout_marginBottom="@dimen/fb_space_8"
                android:text="手写标注" />

            <!-- 笔迹颜色：答题页工具条上的那枚色点也读写这份偏好，两处始终一致 -->
            <LinearLayout style="@style/FbCard">

                <TextView
                    style="@style/FbRowTitle"
                    android:text="笔迹颜色" />

                <TextView
                    style="@style/FbRowSub"
                    android:text="点题目右上角的笔进入写画，圈画与写字都用这个颜色" />

                <LinearLayout
                    android:id="@+id/colorRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fb_space_12"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/tvColorHint"
                    style="@style/FbRowSub"
                    android:layout_marginTop="@dimen/fb_space_12"
                    tools:text="当前：红笔。笔迹跟随本次作答记录保存，每题只留最新一份，退出重进还在。" />
            </LinearLayout>

            <TextView
                style="@style/FbGroupTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fb_section_gap"
                android:layout_marginBottom="@dimen/fb_space_8"
                android:text="支持的试卷格式" />

            <LinearLayout style="@style/FbCard">

                <TextView
                    style="@style/FbRowTitle"
                    android:text="JSON / CSV / Excel(.xlsx) / TXT" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fb_space_8"
                    android:lineSpacingExtra="5dp"
                    android:text="表头支持中英文别名，例如「题干 / 题目 / stem」「答案 / 正确答案 / answer」「选项A / option_a」。\n\n多选题答案写成 A,C；填空题多个空用 | 分隔；主观题得分关键词用 ; 分隔。"
                    android:textColor="@color/fb_text_meta"
                    android:textSize="@dimen/fb_text_item_sub" />
            </LinearLayout>

            <TextView
                style="@style/FbGroupTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fb_section_gap"
                android:layout_marginBottom="@dimen/fb_space_8"
                android:text="备份与恢复" />

            <LinearLayout style="@style/FbCard">

                <LinearLayout
                    android:id="@+id/rowBackup"
                    style="@style/FbSwitchRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FbRowTitle"
                            android:text="备份与恢复" />

                        <TextView
                            style="@style/FbRowSub"
                            android:text="试卷、作答、笔迹、配图打成一份包，可存进网盘；换机时整份还原" />
                    </LinearLayout>

                    <TextView
                        style="@style/FbRowArrow"
                        android:text="›" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
