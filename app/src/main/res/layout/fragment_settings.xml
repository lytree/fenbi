<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="判题规则"
            style="@style/TextTitle"
            android:paddingVertical="8dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swMulti"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card"
            android:padding="14dp"
            android:text="多选题少选也给部分分"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swUncertain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card"
            android:padding="14dp"
            android:text="不定项少选给 50% 分"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swFill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card"
            android:padding="14dp"
            android:text="填空题漏填给部分分"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swSubjective"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card"
            android:padding="14dp"
            android:text="主观题按关键词命中给部分分"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swJudgeLenient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card"
            android:padding="14dp"
            android:text="判断题兼容「对/错/√/×/T/F」多种写法"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="支持的题库格式"
            style="@style/TextTitle"
            android:paddingVertical="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card"
            android:padding="14dp"
            android:textSize="13sp"
            android:lineSpacingExtra="6dp"
            android:text="JSON / CSV / Excel(.xlsx) / TXT\n\n表头支持中英文别名，例如「题干 / 题目 / stem」「答案 / 正确答案 / answer」「选项A / option_a」。\n\n多选题答案写成 A,C；填空题多个空用 | 分隔；主观题得分关键词用 ; 分隔。" />
    </LinearLayout>
</ScrollView>
