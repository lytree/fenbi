<?xml version="1.0" encoding="utf-8"?>
<!--
  词库页：统一标题栏 + 搜索框 + 分类筛选胶囊 + 按拼音首字母分组的词条列表（右侧字母索引条）
  搜索与归类筛选都并进了本页（原「成语汇总」页已合并到这里）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fb_page_bg"
    android:orientation="vertical">

    <com.lytree.qbank.ui.FbTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 词库 / 政治 / 常识 三段切换 -->
    <include
        android:id="@+id/librarySwitch"
        layout="@layout/view_library_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 搜索：词条 / 拼音 / 释义 / 标签都能命中（原成语页的搜索框挪到这里） -->
    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/fb_page_pad"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="@dimen/fb_page_pad"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_fb_search"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="@dimen/fb_space_8"
        android:gravity="center_vertical"
        android:hint="@string/word_search_hint"
        android:imeOptions="actionSearch"
        android:includeFontPadding="false"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/fb_text_body"
        android:textColorHint="@color/fb_text_hint"
        android:textSize="@dimen/fb_text_body_size" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/fb_page_pad"
        android:paddingTop="2dp"
        android:paddingEnd="@dimen/fb_page_pad"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/chipAll"
            style="@style/FbChipSelected"
            android:layout_height="30dp"
            android:minWidth="56dp"
            android:text="@string/word_filter_all" />

        <TextView
            android:id="@+id/chipIdiom"
            style="@style/FbChip"
            android:layout_height="30dp"
            android:minWidth="56dp"
            android:text="@string/word_filter_idiom" />

        <TextView
            android:id="@+id/chipWord"
            style="@style/FbChip"
            android:layout_height="30dp"
            android:minWidth="56dp"
            android:text="@string/word_filter_word" />

        <TextView
            android:id="@+id/chipTag"
            style="@style/FbChip"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:minWidth="46dp"
            android:text="@string/word_filter_tag" />

        <TextView
            android:id="@+id/tvCount"
            style="@style/FbGroupTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:paddingEnd="10dp" />
    </LinearLayout>

    <!-- 已选标签：单独一行横滚，点一下去掉单个标签，不必再进弹窗 -->
    <HorizontalScrollView
        android:id="@+id/tagBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/fb_page_pad"
        android:paddingEnd="@dimen/fb_page_pad"
        android:paddingBottom="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/tagChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/fb_card_bg"
            android:clipToPadding="false"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp"
            android:scrollbars="none" />

        <!-- 右侧字母索引：有词的字母才出现，点一下跳到该组 -->
        <LinearLayout
            android:id="@+id/indexBar"
            android:layout_width="18dp"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:orientation="vertical" />

        <!-- 筛选 / 搜索叠加后一条都不剩时的提示（词库本身有词，只是筛掉了） -->
        <LinearLayout
            android:id="@+id/noResultBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/fb_card_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="60dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/word_no_result"
                android:textColor="@color/fb_text_meta"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnClearFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="?attr/selectableItemBackground"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/word_clear_filter"
                android:textColor="@color/fb_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/emptyBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/fb_page_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="40dp"
            android:paddingBottom="60dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="5dp"
                android:text="@string/empty_words"
                android:textColor="@color/fb_text_meta"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/emptyAction"
                style="@style/FbPrimaryButton"
                android:layout_width="wrap_content"
                android:layout_marginTop="20dp"
                android:minWidth="132dp"
                android:paddingHorizontal="28dp"
                android:text="@string/title_word_import" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
