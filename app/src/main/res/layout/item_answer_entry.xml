<?xml version="1.0" encoding="utf-8"?>
<!-- 补录答案行：题号 + 题型标签 + 我的作答 + 题干 + 标准答案输入框 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/fb_card_gap_v"
    android:background="@drawable/bg_fb_card"
    android:orientation="vertical"
    android:padding="@dimen/fb_card_pad">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvIndex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fb_text_title"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_fb_tag"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/fb_type_tag_padding_h"
            android:paddingTop="@dimen/fb_type_tag_padding_v"
            android:paddingEnd="@dimen/fb_type_tag_padding_h"
            android:paddingBottom="@dimen/fb_type_tag_padding_v"
            android:textColor="@color/fb_type_tag_text"
            android:textSize="@dimen/fb_type_tag_text_size" />

        <TextView
            android:id="@+id/tvMine"
            style="@style/FbItemSub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:lineSpacingExtra="3dp"
        android:maxLines="3"
        android:textColor="@color/fb_text_title"
        android:textSize="14sp" />

    <!-- 标准答案输入：单行，字母/汉字都收 -->
    <EditText
        android:id="@+id/etAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_fb_answer_input"
        android:hint="@string/fill_answer_input_hint"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:minHeight="40dp"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:textColor="@color/fb_text_title"
        android:textColorHint="@color/fb_text_hint"
        android:textSize="14sp" />
</LinearLayout>
