<?xml version="1.0" encoding="utf-8"?>
<!-- 补录答案行：题号 + 题型标签 + 我的作答 + 题干 + 标准答案输入框
     父容器（补录页列表）已经给了左右 16dp，这里只加卡间距 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/FbCard"
    android:layout_marginTop="@dimen/fb_card_gap_v">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvIndex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fb_text_title"
            android:textSize="@dimen/fb_text_body_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvType"
            style="@style/FbTag"
            android:layout_marginStart="@dimen/fb_space_8" />

        <TextView
            android:id="@+id/tvMine"
            style="@style/FbItemSub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fb_space_8"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStem"
        style="@style/FbBody"
        android:layout_marginTop="@dimen/fb_space_8"
        android:ellipsize="end"
        android:lineSpacingExtra="3dp"
        android:maxLines="3" />

    <!-- 标准答案输入：单行，字母/汉字都收 -->
    <EditText
        android:id="@+id/etAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_space_12"
        android:background="@drawable/bg_fb_answer_input"
        android:hint="@string/fill_answer_input_hint"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:minHeight="40dp"
        android:paddingStart="@dimen/fb_space_12"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/fb_space_12"
        android:paddingBottom="10dp"
        android:textColor="@color/fb_text_title"
        android:textColorHint="@color/fb_text_hint"
        android:textSize="@dimen/fb_text_body_size" />
</LinearLayout>
