<?xml version="1.0" encoding="utf-8"?>
<!-- 题库卡：8dp 圆角白卡，右侧 chevron，题量做浅蓝标签 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/fb_page_pad"
    android:layout_marginEnd="@dimen/fb_page_pad"
    android:layout_marginTop="@dimen/fb_card_gap_v"
    android:background="@drawable/bg_fb_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/fb_card_pad">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/FbItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/subtitle"
            style="@style/FbItemSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_fb_tag"
            android:includeFontPadding="false"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="@color/fb_type_tag_text"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_fb_chevron" />
</LinearLayout>
