<?xml version="1.0" encoding="utf-8"?>
<!-- 题库卡：列表卡（白底 8dp 圆角 / 左右 16dp / 卡间距 12dp / 卡内 16dp），右侧 chevron，题量做浅蓝标签 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/FbListCard"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/FbItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/subtitle"
            style="@style/FbItemSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fb_space_4" />

        <TextView
            android:id="@+id/meta"
            style="@style/FbTag"
            android:layout_marginTop="@dimen/fb_space_8" />
    </LinearLayout>

    <ImageView
        android:layout_width="@dimen/fb_icon_size"
        android:layout_height="@dimen/fb_icon_size"
        android:layout_marginStart="@dimen/fb_space_8"
        android:contentDescription="@null"
        android:src="@drawable/ic_fb_chevron" />
</LinearLayout>
