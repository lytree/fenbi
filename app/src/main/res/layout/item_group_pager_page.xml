<?xml version="1.0" encoding="utf-8"?>
<!--
  单题浏览的「材料组页」（ViewPager2 的 item，一则材料带多道小题时使用）。

  与旧版「材料 + 小题挤在同一个滚动容器里」不同，这页是**上下分栏**：
  · 上区：材料固定展示（独立纵向滚动，做题时材料始终在屏）；
  · 中间：拖拽手柄，上下拖动调节上下占比（20%～80%，偏好记忆）；
  · 下区：本组小题**悬浮面板**——顶部 12dp 圆角 + elevation 投影，叠在卷面上方，
    面板内独立纵向滚动，小题依次往下排、照常作答；
  · 横向手势仍留给 ViewPager2 翻页，纵向手势归两个滚动区 / 手柄。

  页内卡片由 QuestionPagerAdapter 动态塞进 cardContainer（卡片本体复用
  item_question_page.xml，与其他页同一套版式）；pageScroll / cardContainer 的 id
  与普通页保持一致，答题页的 locateInPage / inkAnchors 不用改取法。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/groupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 手柄位置（占位用 guideline，拖动时改 percent 即可），比例 = 手柄中心距页顶 -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/groupGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.45" />

    <!-- ===== 上区：材料（独立滚动）===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/materialScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/groupHandle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/materialContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/fb_content_padding_h"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/fb_content_padding_h"
            android:paddingBottom="8dp"
            tools:ignore="UselessParent" />
    </androidx.core.widget.NestedScrollView>

    <!-- ===== 中间：拖拽手柄（整条都是热区，grip 只是个视觉小横条）===== -->
    <FrameLayout
        android:id="@+id/groupHandle"
        android:layout_width="0dp"
        android:layout_height="28dp"
        app:layout_constraintBottom_toBottomOf="@id/groupGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/groupGuideline">

        <View
            android:id="@+id/groupHandleBar"
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_fb_drag_bar" />
    </FrameLayout>

    <!-- ===== 下区：悬浮题目面板（圆角 + 投影，独立滚动）===== -->
    <FrameLayout
        android:id="@+id/questionPane"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_fb_sheet"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/groupHandle">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/pageScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="24dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/cardContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
