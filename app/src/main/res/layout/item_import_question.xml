<?xml version="1.0" encoding="utf-8"?>
<!-- 导入预览行：勾选框 + 题型标签 + 题干 + 选项/答案 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/fb_space_8"
    android:background="@drawable/bg_fb_card"
    android:orientation="horizontal"
    android:paddingStart="@dimen/fb_space_12"
    android:paddingTop="@dimen/fb_space_12"
    android:paddingEnd="@dimen/fb_space_12"
    android:paddingBottom="@dimen/fb_space_12">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cb"
        style="@style/FbCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:minWidth="32dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fb_space_4"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvType"
            style="@style/FbTag" />

        <TextView
            android:id="@+id/tvStem"
            style="@style/FbBody"
            android:layout_marginTop="@dimen/fb_space_8"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="4" />

        <TextView
            android:id="@+id/tvOptions"
            style="@style/FbItemSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fb_space_4"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="6" />

        <TextView
            android:id="@+id/tvAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fb_space_4"
            android:textColor="@color/fb_success"
            android:textSize="@dimen/fb_text_item_sub" />
    </LinearLayout>
</LinearLayout>
