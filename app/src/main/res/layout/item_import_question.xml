<?xml version="1.0" encoding="utf-8"?>
<!-- 导入预览行：勾选框 + 题型标签 + 题干 + 选项/答案 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_fb_card"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="14dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cb"
        style="@style/FbCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:minWidth="32dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_fb_tag"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/fb_type_tag_padding_h"
            android:paddingTop="@dimen/fb_type_tag_padding_v"
            android:paddingEnd="@dimen/fb_type_tag_padding_h"
            android:paddingBottom="@dimen/fb_type_tag_padding_v"
            android:textColor="@color/fb_type_tag_text"
            android:textSize="@dimen/fb_type_tag_text_size" />

        <TextView
            android:id="@+id/tvStem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="4"
            android:textColor="@color/fb_text_title"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvOptions"
            style="@style/FbItemSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="6" />

        <TextView
            android:id="@+id/tvAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/right"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
