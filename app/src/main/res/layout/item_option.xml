<?xml version="1.0" encoding="utf-8"?>
<!--
  选项行（全站唯一的选项版式）：圆形徽标 + 单列正文。
  · 徽标 32dp（平板 46dp），字母 15sp，未选浅蓝灰描边
  · 正文 16sp 次级色，行距 5dp；徽标与文字块上下居中（多行时圈落在文字块中间）
  · 正文下面可以带图：图形推理那种「四个选项就是四张图」的题，
    图片由 QuestionCardBinder.bindOptionBody 塞进 optionMedia（默认隐藏，纯文字选项没有额外开销）
  · 选项全是图时改横排（QuestionCardBinder.buildImageOptionsRow）：同一份布局在代码里
    转成竖排（徽标在上、图在下），宽度由外层均分，图按格宽缩小
  · 左右留白走 fb_option_row_padding_start / fb_content_padding_h，与题干对齐
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/FbOptionRow">

    <TextView
        android:id="@+id/tvKey"
        android:layout_width="@dimen/fb_option_circle"
        android:layout_height="@dimen/fb_option_circle"
        android:background="@drawable/bg_fb_circle"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/fb_circle_text"
        android:textSize="@dimen/fb_option_circle_text_size"
        tools:text="A" />

    <LinearLayout
        android:id="@+id/optionBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fb_option_text_gap"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="@dimen/fb_option_line_space"
            android:textColor="@color/fb_option_text"
            android:textSize="@dimen/fb_option_text_size"
            tools:text="大力推进健康学校建设，坚持健康第一的教育理念，提升学生健康素养" />

        <!-- 选项配图（见 QuestionCardBinder.bindOptionBody）：按选项正文宽度铺开 -->
        <LinearLayout
            android:id="@+id/optionMedia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- 长按划掉（排除法）后的叉号：默认隐藏，见 QuestionCardBinder.applyCrossState。
         放在正文右侧而不是左上角——选项是多行时右上角会顶着一行字，右边留白处最不抢视线；
         纯图选项横排时这一行被转成竖排，叉号落到图下方居中。 -->
    <ImageView
        android:id="@+id/ivCross"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_fb_cross"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
