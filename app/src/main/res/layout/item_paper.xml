<?xml version="1.0" encoding="utf-8"?>
<!--
  组内试卷卡：标题 + 「N 题 · 限时」元信息，行尾缺答案胶囊 + 展开箭头。
  · 整卡可点 = 整卷作答；行尾箭头单独吃点击，只负责展开 / 收起「大类 → 材料」
  · 缺答案时箭头左边挂一个橙色胶囊
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/FbListCardLinePressable"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/FbItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2" />

        <TextView
            android:id="@+id/subtitle"
            style="@style/FbItemSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fb_space_4"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/missing"
        style="@style/FbPillWarning"
        android:layout_marginStart="@dimen/fb_space_8"
        android:visibility="gone"
        tools:text="缺 3 答案"
        tools:visibility="visible" />

    <!-- 展开层级：默认朝右，展开后转 90° 朝下 -->
    <ImageView
        android:id="@+id/expand"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/fb_space_8"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/tree_expand"
        android:padding="3dp"
        android:src="@drawable/ic_fb_chevron" />
</LinearLayout>
