<?xml version="1.0" encoding="utf-8"?>
<!-- 试卷 / 记录卡：左侧标题 + 元信息，右侧强调数字（得分 / 正确率） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/FbListCard"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/FbItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/subtitle"
            style="@style/FbItemSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fb_space_4" />
    </LinearLayout>

    <TextView
        android:id="@+id/score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fb_space_12"
        android:includeFontPadding="false"
        android:textColor="@color/fb_primary"
        android:textSize="@dimen/fb_text_bar_title"
        android:textStyle="bold" />
</LinearLayout>
