<?xml version="1.0" encoding="utf-8"?>
<!-- 试卷 / 记录卡：左侧标题 + 元信息，右侧强调数字（得分 / 正确率） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/fb_page_pad"
    android:layout_marginEnd="@dimen/fb_page_pad"
    android:layout_marginTop="@dimen/fb_card_gap_v"
    android:background="@drawable/bg_fb_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/fb_card_pad">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/FbItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/subtitle"
            style="@style/FbItemSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:includeFontPadding="false"
        android:textColor="@color/fb_primary"
        android:textSize="19sp"
        android:textStyle="bold" />
</LinearLayout>
