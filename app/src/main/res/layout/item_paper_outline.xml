<?xml version="1.0" encoding="utf-8"?>
<!--
  试卷目录的一行：整卷 / 一个大类 / 一则材料。
  · 整行可点 = 只做这一层（进答题页，范围带过去）
  · 行尾「N 题」胶囊 + chevron，和首页试卷卡同一套视觉
  · 材料的缩进由代码设 marginStart，一份卷里三级共用一个布局
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/FbListCardLinePressable"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/FbItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2" />

        <TextView
            android:id="@+id/subtitle"
            style="@style/FbItemSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fb_space_4"
            android:maxLines="2"
            android:visibility="gone"
            tools:text="数量关系 20题"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/count"
        style="@style/FbPill"
        android:layout_marginStart="@dimen/fb_space_8"
        tools:text="20 题" />

    <ImageView
        android:id="@+id/chevron"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="@dimen/fb_space_4"
        android:contentDescription="@null"
        android:src="@drawable/ic_fb_chevron" />
</LinearLayout>
