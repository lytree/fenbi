<?xml version="1.0" encoding="utf-8"?>
<!-- 题目卡（题库详情目录）：与答题页同一张卡，但不带选项圆徽标 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/fb_page_pad"
    android:layout_marginEnd="@dimen/fb_page_pad"
    android:layout_marginTop="@dimen/fb_card_gap_v"
    android:background="@drawable/bg_fb_card"
    android:orientation="vertical"
    android:padding="@dimen/fb_card_pad">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_fb_tag"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/fb_type_tag_padding_h"
            android:paddingTop="@dimen/fb_type_tag_padding_v"
            android:paddingEnd="@dimen/fb_type_tag_padding_h"
            android:paddingBottom="@dimen/fb_type_tag_padding_v"
            android:textColor="@color/fb_type_tag_text"
            android:textSize="@dimen/fb_type_tag_text_size" />

        <TextView
            android:id="@+id/tvMeta"
            style="@style/FbItemSub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="@dimen/fb_question_line_space"
        android:textColor="@color/fb_text_title"
        android:textSize="@dimen/fb_question_text_size" />

    <TextView
        android:id="@+id/tvOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/fb_option_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/right"
        android:textSize="13sp" />
</LinearLayout>
