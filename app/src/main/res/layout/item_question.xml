<?xml version="1.0" encoding="utf-8"?>
<!-- 题目卡（试卷详情目录）：与答题页同一套字色/字号，但不带选项圆徽标 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/FbListCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvType"
            style="@style/FbTag" />

        <TextView
            android:id="@+id/tvMeta"
            style="@style/FbItemSub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fb_space_8"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStem"
        style="@style/FbStem"
        android:layout_marginTop="@dimen/fb_space_12" />

    <TextView
        android:id="@+id/tvOptions"
        style="@style/FbBody"
        android:layout_marginTop="@dimen/fb_space_8"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/fb_option_text" />

    <TextView
        android:id="@+id/tvAnswer"
        style="@style/FbBodySm"
        android:layout_marginTop="@dimen/fb_space_12"
        android:textColor="@color/fb_success" />
</LinearLayout>
