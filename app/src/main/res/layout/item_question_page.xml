<?xml version="1.0" encoding="utf-8"?>
<!--
  「卷面题块」（1080x1920 @280dpi 基准，对齐参考应用真机截图）：
  · 整页白底通铺，不再是一张张圆角白卡——题与题之间只隔一条 0.5dp 细线（#EFF1F4）
  · 模块切换处先出「模块说明卡」：浅蓝渐变圆角块 + 「资料分析 (20题)」标题 + 该模块作答说明
  · 材料题：材料块在本块最上方通栏展示（白底、无内嵌灰卡），下面才是题号行
  · 题目行：题号「N.」(17sp/#1B2126) + 题型标签(11sp/#F1F3FF) + 右侧 标记/笔/收藏(28dp)
  · 题干 16sp/#1B2126/额外行距 7dp；选项 32dp 圆形徽标 + 16sp/#3C464F 正文、单列
  左右留白统一走 fb_content_padding_h（20dp），宽屏时列宽由 activity_exam.xml 的约束卡上限。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/fb_sheet_bg"
    android:orientation="vertical">

    <!-- ===== 模块说明卡（同一模块只在首题出现一次；样式见 view_module_header.xml）=====
         单题浏览里它不在这里，而是单独占一页（item_module_page.xml），两者共用同一份卡片样式 -->
    <include
        android:id="@+id/moduleHeader"
        layout="@layout/view_module_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fb_content_padding_h"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/fb_content_padding_h" />

    <!-- ===== 材料（资料分析 / 材料题）=====
         对齐参考应用：材料整块在本块顶部通栏展示，随卷面一起滚动；
         长材料用右上角「弹出材料」看全屏 -->
    <LinearLayout
        android:id="@+id/materialBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/fb_content_padding_h"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/fb_content_padding_h"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMaterialTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_fb_material_tag"
                android:includeFontPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="@string/tag_material"
                android:textColor="@color/fb_type_tag_text"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 弹出材料：材料单独占大半屏、独立滚动，题目位置不动 -->
            <LinearLayout
                android:id="@+id/btnMaterialExpand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="3dp"
                android:paddingEnd="2dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:id="@+id/icMaterialExpand"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_fb_material_expand" />

                <TextView
                    android:id="@+id/tvMaterialExpand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:includeFontPadding="false"
                    android:text="@string/material_pop_out"
                    android:textColor="@color/fb_text_meta"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/materialContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- ===== 题目行：题号 + 题型 + 三图标 ===== -->
    <LinearLayout
        android:id="@+id/questionActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/fb_content_padding_h"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/fb_content_padding_h"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/tvIndex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/fb_text_title"
            android:textSize="@dimen/fb_question_text_size"
            tools:text="106." />

        <TextView
            android:id="@+id/tvType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_fb_tag"
            android:paddingStart="@dimen/fb_type_tag_padding_h"
            android:paddingTop="@dimen/fb_type_tag_padding_v"
            android:paddingEnd="@dimen/fb_type_tag_padding_h"
            android:paddingBottom="@dimen/fb_type_tag_padding_v"
            android:textColor="@color/fb_type_tag_text"
            android:textSize="@dimen/fb_type_tag_text_size"
            tools:text="单选题" />

        <!-- 待补答案：导入时这道题就没有标准答案 -->
        <TextView
            android:id="@+id/tvPending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_fb_tag"
            android:paddingStart="@dimen/fb_type_tag_padding_h"
            android:paddingTop="@dimen/fb_type_tag_padding_v"
            android:paddingEnd="@dimen/fb_type_tag_padding_h"
            android:paddingBottom="@dimen/fb_type_tag_padding_v"
            android:text="@string/pending_answer"
            android:textColor="@color/partial"
            android:textSize="@dimen/fb_type_tag_text_size"
            android:visibility="gone"
            tools:visibility="visible" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 标记（细线星）/ 笔（手写标注，长按写笔记）/ 收藏（星） -->
        <ImageView
            android:id="@+id/btnMark"
            android:layout_width="@dimen/fb_bar_item_width"
            android:layout_height="@dimen/fb_bar_item_width"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_mark"
            android:padding="4dp"
            android:src="@drawable/ic_fb_star_outline" />

        <ImageView
            android:id="@+id/btnScratch"
            android:layout_width="@dimen/fb_bar_item_width"
            android:layout_height="@dimen/fb_bar_item_width"
            android:layout_marginStart="@dimen/fb_bar_item_gap"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_ink_edit"
            android:padding="4dp"
            android:src="@drawable/ic_fb_edit" />

        <ImageView
            android:id="@+id/btnFavorite"
            android:layout_width="@dimen/fb_bar_item_width"
            android:layout_height="@dimen/fb_bar_item_width"
            android:layout_marginStart="@dimen/fb_bar_item_gap"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_favorite"
            android:padding="4dp"
            android:src="@drawable/ic_fb_star" />
    </LinearLayout>

    <!-- ===== 题干 ===== -->
    <TextView
        android:id="@+id/tvStem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="@dimen/fb_question_line_space"
        android:paddingStart="@dimen/fb_content_padding_h"
        android:paddingEnd="@dimen/fb_content_padding_h"
        android:textColor="@color/fb_text_body"
        android:textSize="@dimen/fb_question_text_size"
        tools:text="2025年1-11月，B市大中型重点企业研发费用中工业企业占比同比约：" />

    <!-- ===== 选项 ===== -->
    <LinearLayout
        android:id="@+id/optionsBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical" />

    <!-- ===== 笔记 ===== -->
    <TextView
        android:id="@+id/tvNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fb_content_padding_h"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="@dimen/fb_content_padding_h"
        android:background="@drawable/bg_fb_note"
        android:lineSpacingExtra="3dp"
        android:padding="10dp"
        android:textColor="@color/fb_text_tertiary"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="笔记：注意区分前瞻性与创新性"
        tools:visibility="visible" />

    <!-- ===== 解析 ===== -->
    <TextView
        android:id="@+id/tvAnalysis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fb_content_padding_h"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/fb_content_padding_h"
        android:background="@drawable/bg_fb_note"
        android:lineSpacingExtra="4dp"
        android:padding="12dp"
        android:textColor="@color/fb_text_primary"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- ===== 题间分隔线（白底通铺靠它分题） ===== -->
    <View
        android:id="@+id/vDivider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="18dp"
        android:background="@color/fb_question_divider" />
</LinearLayout>
