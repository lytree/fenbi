<?xml version="1.0" encoding="utf-8"?>
<!--
  「卷面题块」（对齐粉笔真机截图）：
  · 整页白底通铺，题与题之间只隔一条 0.5dp 细线（fb_question_divider）
  · 模块切换处先出「模块说明卡」：浅蓝渐变圆角块 + 「资料分析 (20题)」标题 + 该模块作答说明
  · 材料题：材料块在本块最上方通栏展示，下面才是题号行
  · 题目行：题号「N.」+ 题型标签 + 右侧 标记/笔/收藏（28dp）
  · 题干 16sp / 选项 32dp 圆标 + 16sp 正文、单列
  左右留白统一走 fb_content_padding_h（约 5% 屏宽：手机 22dp / 小平板 32dp / 大平板 40dp）；
  卷面宽度不设上限，宽屏时直接铺满可用宽度。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/fb_sheet_bg"
    android:orientation="vertical">

    <!-- ===== 模块说明卡（同一模块只在首题出现一次；样式见 view_module_header.xml）=====
         单题浏览里它不在这里，而是单独占一页（item_module_page.xml），两者共用同一份卡片样式 -->
    <include
        android:id="@+id/moduleHeader"
        layout="@layout/view_module_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fb_content_padding_h"
        android:layout_marginTop="@dimen/fb_space_12"
        android:layout_marginEnd="@dimen/fb_content_padding_h" />

    <!-- ===== 材料（资料分析 / 材料题）=====
         对齐粉笔：材料整块在本块顶部通栏展示，随卷面一起滚动；
         长材料用右上角「弹出材料」看全屏 -->
    <LinearLayout
        android:id="@+id/materialBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/fb_content_padding_h"
        android:paddingTop="@dimen/fb_space_16"
        android:paddingEnd="@dimen/fb_content_padding_h"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMaterialTag"
                style="@style/FbTag"
                android:text="@string/tag_material" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 弹出材料：材料单独占大半屏、独立滚动，题目位置不动 -->
            <LinearLayout
                android:id="@+id/btnMaterialExpand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/fb_space_4"
                android:paddingTop="@dimen/fb_space_4"
                android:paddingEnd="@dimen/fb_space_4"
                android:paddingBottom="@dimen/fb_space_4">

                <ImageView
                    android:id="@+id/icMaterialExpand"
                    android:layout_width="@dimen/fb_icon_sm_size"
                    android:layout_height="@dimen/fb_icon_sm_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_fb_material_expand" />

                <TextView
                    android:id="@+id/tvMaterialExpand"
                    style="@style/FbCaption"
                    android:layout_marginStart="@dimen/fb_space_4"
                    android:text="@string/material_pop_out" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/materialContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fb_space_12"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- ===== 题目行：题号 + 题型 + 三图标 ===== -->
    <LinearLayout
        android:id="@+id/questionActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/fb_content_padding_h"
        android:paddingTop="@dimen/fb_space_20"
        android:paddingEnd="@dimen/fb_content_padding_h"
        android:paddingBottom="@dimen/fb_space_4">

        <TextView
            android:id="@+id/tvIndex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/fb_text_title"
            android:textSize="@dimen/fb_question_text_size"
            tools:text="106." />

        <TextView
            android:id="@+id/tvType"
            style="@style/FbTag"
            android:layout_marginStart="@dimen/fb_space_4"
            tools:text="单选题" />

        <!-- 待补答案：导入时这道题就没有标准答案 -->
        <TextView
            android:id="@+id/tvPending"
            style="@style/FbTagWarning"
            android:layout_marginStart="@dimen/fb_space_4"
            android:text="@string/pending_answer"
            android:visibility="gone"
            tools:visibility="visible" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 标记（细线星）/ 笔（手写标注，长按写笔记）/ 收藏（星） -->
        <ImageView
            android:id="@+id/btnMark"
            android:layout_width="@dimen/fb_bar_item_width"
            android:layout_height="@dimen/fb_bar_item_width"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_mark"
            android:padding="4dp"
            android:src="@drawable/ic_fb_star_outline" />

        <ImageView
            android:id="@+id/btnScratch"
            android:layout_width="@dimen/fb_bar_item_width"
            android:layout_height="@dimen/fb_bar_item_width"
            android:layout_marginStart="@dimen/fb_bar_item_gap"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_ink_edit"
            android:padding="4dp"
            android:src="@drawable/ic_fb_edit" />

        <ImageView
            android:id="@+id/btnFavorite"
            android:layout_width="@dimen/fb_bar_item_width"
            android:layout_height="@dimen/fb_bar_item_width"
            android:layout_marginStart="@dimen/fb_bar_item_gap"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_favorite"
            android:padding="4dp"
            android:src="@drawable/ic_fb_star" />
    </LinearLayout>

    <!-- ===== 题干 ===== -->
    <TextView
        android:id="@+id/tvStem"
        style="@style/FbStem"
        android:layout_marginTop="@dimen/fb_space_16"
        android:paddingStart="@dimen/fb_content_padding_h"
        android:paddingEnd="@dimen/fb_content_padding_h"
        tools:text="2025年1-11月，B市大中型重点企业研发费用中工业企业占比同比约：" />

    <!-- ===== 选项 ===== -->
    <LinearLayout
        android:id="@+id/optionsBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_space_12"
        android:orientation="vertical" />

    <!-- ===== 笔记 ===== -->
    <TextView
        android:id="@+id/tvNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fb_content_padding_h"
        android:layout_marginTop="@dimen/fb_space_8"
        android:layout_marginEnd="@dimen/fb_content_padding_h"
        android:background="@drawable/bg_fb_note"
        android:lineSpacingExtra="3dp"
        android:padding="@dimen/fb_space_12"
        android:textColor="@color/fb_text_tertiary"
        android:textSize="@dimen/fb_text_body_sm"
        android:visibility="gone"
        tools:text="笔记：注意区分前瞻性与创新性"
        tools:visibility="visible" />

    <!-- ===== 解析 ===== -->
    <TextView
        android:id="@+id/tvAnalysis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fb_content_padding_h"
        android:layout_marginTop="@dimen/fb_space_12"
        android:layout_marginEnd="@dimen/fb_content_padding_h"
        android:background="@drawable/bg_fb_note"
        android:lineSpacingExtra="4dp"
        android:padding="@dimen/fb_space_12"
        android:textColor="@color/fb_text_primary"
        android:textSize="@dimen/fb_text_body_size"
        android:visibility="gone" />

    <!-- ===== 题间分隔线（白底通铺靠它分题） ===== -->
    <View
        android:id="@+id/vDivider"
        style="@style/FbDivider"
        android:layout_marginTop="@dimen/fb_space_20"
        android:background="@color/fb_question_divider" />
</LinearLayout>
