<?xml version="1.0" encoding="utf-8"?>
<!--
  「单题卡」题目块（1080x1920 @280dpi 基准）：
  · 白底 8dp 圆角卡片，卡片间距 16dp，页面底色 #F9FAFC
  · 题目行：题号「N.」(17sp/#1B2126) + 题型标签(11sp/#F1F3FF) + 右侧 标记/草稿/收藏(28dp)
  · 题干 17sp/#1B2126/额外行距 8dp
  · 选项：40dp 圆形徽标 + 16sp/#3C464F 正文
  左右外边距由 QuestionListAdapter 按「内容最大宽 520dp」动态设置。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/fb_page_padding_h"
    android:layout_marginEnd="@dimen/fb_page_padding_h"
    android:layout_marginBottom="@dimen/fb_card_gap"
    android:background="@drawable/bg_fb_card"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <!-- ===== 题目行：题号 + 题型 + 三图标 ===== -->
    <LinearLayout
        android:id="@+id/questionActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/fb_content_padding_h"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/fb_content_padding_h"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/tvIndex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/fb_text_title"
            android:textSize="@dimen/fb_question_text_size"
            tools:text="2." />

        <TextView
            android:id="@+id/tvType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_fb_tag"
            android:paddingStart="@dimen/fb_type_tag_padding_h"
            android:paddingTop="@dimen/fb_type_tag_padding_v"
            android:paddingEnd="@dimen/fb_type_tag_padding_h"
            android:paddingBottom="@dimen/fb_type_tag_padding_v"
            android:textColor="@color/fb_type_tag_text"
            android:textSize="@dimen/fb_type_tag_text_size"
            tools:text="单选题" />

        <!-- 待补答案：导入时这道题就没有标准答案 -->
        <TextView
            android:id="@+id/tvPending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_fb_tag"
            android:paddingStart="@dimen/fb_type_tag_padding_h"
            android:paddingTop="@dimen/fb_type_tag_padding_v"
            android:paddingEnd="@dimen/fb_type_tag_padding_h"
            android:paddingBottom="@dimen/fb_type_tag_padding_v"
            android:text="@string/pending_answer"
            android:textColor="@color/partial"
            android:textSize="@dimen/fb_type_tag_text_size"
            android:visibility="gone"
            tools:visibility="visible" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 标记 / 手写标注（长按写笔记）/ 收藏 -->
        <ImageView
            android:id="@+id/btnMark"
            android:layout_width="@dimen/fb_bar_item_width"
            android:layout_height="@dimen/fb_bar_item_width"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_mark"
            android:padding="4dp"
            android:src="@drawable/ic_fb_bookmark" />

        <ImageView
            android:id="@+id/btnScratch"
            android:layout_width="@dimen/fb_bar_item_width"
            android:layout_height="@dimen/fb_bar_item_width"
            android:layout_marginStart="@dimen/fb_bar_item_gap"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_ink_edit"
            android:padding="4dp"
            android:src="@drawable/ic_fb_edit" />

        <ImageView
            android:id="@+id/btnFavorite"
            android:layout_width="@dimen/fb_bar_item_width"
            android:layout_height="@dimen/fb_bar_item_width"
            android:layout_marginStart="@dimen/fb_bar_item_gap"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_favorite"
            android:padding="4dp"
            android:src="@drawable/ic_fb_star" />
    </LinearLayout>

    <!-- ===== 题干 ===== -->
    <TextView
        android:id="@+id/tvStem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:lineSpacingExtra="@dimen/fb_question_line_space"
        android:paddingStart="@dimen/fb_content_padding_h"
        android:paddingEnd="@dimen/fb_content_padding_h"
        android:textColor="@color/fb_text_body"
        android:textSize="@dimen/fb_question_text_size"
        tools:text="习近平总书记强调，必须从全局和战略高度推进党和国家各项事业……下列选项中，与该论述蕴含的哲学原理一致的是（ ）。" />

    <!-- ===== 材料（资料分析题） ===== -->
    <LinearLayout
        android:id="@+id/materialBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fb_content_padding_h"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/fb_content_padding_h"
        android:background="@drawable/bg_fb_material"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMaterialTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_fb_material_tag"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="@string/tag_material"
                android:textColor="@color/fb_type_tag_text"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 弹出材料：材料单独占大半屏、独立滚动，题目位置不动 -->
            <LinearLayout
                android:id="@+id/btnMaterialExpand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="3dp"
                android:paddingEnd="2dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:id="@+id/icMaterialExpand"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_fb_material_expand" />

                <TextView
                    android:id="@+id/tvMaterialExpand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:includeFontPadding="false"
                    android:text="@string/material_pop_out"
                    android:textColor="@color/fb_text_meta"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 材料区独立滚动：高度由下方拖动手柄调节（对齐参考应用「上下分块、占比可调」） -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/materialScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/materialContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- ===== 材料/题目分块拖动手柄：上下拖动调整材料区高度 ===== -->
    <FrameLayout
        android:id="@+id/materialHandle"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="2dp"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_fb_material_handle" />
    </FrameLayout>

    <!-- ===== 选项 ===== -->
    <LinearLayout
        android:id="@+id/optionsBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical" />

    <!-- ===== 笔记 ===== -->
    <TextView
        android:id="@+id/tvNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fb_content_padding_h"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="@dimen/fb_content_padding_h"
        android:background="@drawable/bg_fb_note"
        android:lineSpacingExtra="3dp"
        android:padding="10dp"
        android:textColor="@color/fb_text_tertiary"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="笔记：注意区分前瞻性与创新性"
        tools:visibility="visible" />

    <!-- ===== 解析 ===== -->
    <TextView
        android:id="@+id/tvAnalysis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fb_content_padding_h"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/fb_content_padding_h"
        android:background="@drawable/bg_fb_note"
        android:lineSpacingExtra="4dp"
        android:padding="12dp"
        android:textColor="@color/fb_text_primary"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
