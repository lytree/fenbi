<?xml version="1.0" encoding="utf-8"?>
<!-- 报告逐题卡：题号 + 判定状态 + 题干 + 我的答案 / 正确答案 + 解析
     父容器（报告页内容列）已经给了左右 16dp，这里只加卡间距，不再加左右外边距 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/FbCard"
    android:layout_marginTop="@dimen/fb_card_gap_v">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvIndex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fb_text_title"
            android:textSize="@dimen/fb_text_body_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMark"
            style="@style/FbTag"
            android:layout_marginStart="@dimen/fb_space_8"
            android:text="@string/action_marked"
            android:textColor="@color/fb_primary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fb_space_8"
            android:layout_weight="1"
            android:gravity="end"
            android:textSize="@dimen/fb_text_item_sub"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStem"
        style="@style/FbBody"
        android:layout_marginTop="@dimen/fb_space_12" />

    <TextView
        android:id="@+id/tvMine"
        style="@style/FbBodySm"
        android:layout_marginTop="@dimen/fb_space_12"
        android:maxLines="4" />

    <TextView
        android:id="@+id/tvCorrect"
        style="@style/FbBodySm"
        android:layout_marginTop="@dimen/fb_space_4"
        android:maxLines="4" />

    <TextView
        android:id="@+id/tvAnalysis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_space_12"
        android:background="@drawable/bg_fb_note"
        android:lineSpacingExtra="4dp"
        android:padding="@dimen/fb_space_12"
        android:textColor="@color/fb_text_secondary"
        android:textSize="@dimen/fb_text_body_sm"
        android:visibility="gone" />
</LinearLayout>
