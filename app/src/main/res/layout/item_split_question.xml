<?xml version="1.0" encoding="utf-8"?>
<!--
  分屏模式下的单题块（对齐参考应用右栏）：
  白底通铺、题与题之间一条 0.5dp 细线；题号不加粗，与主卷面同一套字号。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/fb_sheet_bg"
    android:orientation="vertical"
    android:paddingTop="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/fb_text_title"
            android:textSize="16sp"
            tools:text="106." />

        <TextView
            android:id="@+id/tvType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_fb_tag"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="@color/fb_blue_ink"
            android:textSize="11sp"
            tools:text="单选题" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="7dp"
        android:textColor="@color/fb_text_body"
        android:textSize="16sp"
        tools:text="2025年1-11月，B市大中型重点企业研发费用中工业企业占比同比约：" />

    <LinearLayout
        android:id="@+id/optionsBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/tvAnalysis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@color/right_bg"
        android:lineSpacingExtra="4dp"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 题间细线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="18dp"
        android:background="@color/fb_question_divider" />
</LinearLayout>
