<?xml version="1.0" encoding="utf-8"?>
<!--
  解析卡（解析块的下半张卡）：
  · 白底 + 1dp 描边圆角卡，和上半张浅灰「作答小结卡」分开成两块
  · 标题行：双圆图标 + 「解析」+ 右侧收起箭头，点标题行整节收起 / 展开
  · 正文 15sp、行距 8dp；没有解析内容时整张卡不出现（不摆一个空标题）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_fb_card_line"
    android:orientation="vertical"
    android:paddingStart="@dimen/fb_space_16"
    android:paddingTop="@dimen/fb_space_12"
    android:paddingEnd="@dimen/fb_space_16"
    android:paddingBottom="@dimen/fb_space_16"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:id="@+id/btnAnalysisHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/fb_space_4"
        android:paddingBottom="@dimen/fb_space_4">

        <ImageView
            android:id="@+id/icAnalysis"
            android:layout_width="@dimen/fb_icon_md_size"
            android:layout_height="@dimen/fb_icon_md_size"
            android:contentDescription="@null"
            android:src="@drawable/ic_fb_analysis" />

        <TextView
            android:id="@+id/tvAnalysisTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fb_space_8"
            android:text="@string/analysis_title"
            android:textColor="@color/fb_text_title"
            android:textSize="@dimen/fb_text_card_title"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 收起箭头：展开时朝上（对齐参考截图），收起时朝下 -->
        <ImageView
            android:id="@+id/icAnalysisChevron"
            android:layout_width="@dimen/fb_icon_sm_size"
            android:layout_height="@dimen/fb_icon_sm_size"
            android:contentDescription="@null"
            android:rotation="180"
            android:src="@drawable/ic_fb_chevron_down"
            android:tint="@color/fb_text_hint" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAnalysis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_space_12"
        android:lineSpacingExtra="@dimen/fb_space_8"
        android:textColor="@color/fb_text_body"
        android:textSize="@dimen/fb_text_analysis"
        tools:text="信息技术服务收入：5月＝1月～5月－1月～4月＝21314－16222＝5000⁺ 亿元"
        tools:visibility="visible" />
</LinearLayout>
