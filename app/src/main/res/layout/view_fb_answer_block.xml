<?xml version="1.0" encoding="utf-8"?>
<!--
  作答小结 + 解析：两张卡拼成的一块，这里只做容器。
    · 上：view_fb_answer_summary.xml（浅灰卡：正确答案 / 你的答案）
    · 下：view_fb_analysis_card.xml（白底描边卡：可收起的解析）
  两张卡各自管自己的显隐，容器只在两张都空时整块收起（由 AnswerBlock 控）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <include
        android:id="@+id/summary"
        layout="@layout/view_fb_answer_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/analysis"
        layout="@layout/view_fb_analysis_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_space_12" />
</LinearLayout>
