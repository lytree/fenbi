<?xml version="1.0" encoding="utf-8"?>
<!--
  作答小结 + 解析：两张卡拼成的一块，这里只做容器。
    · 上：view_fb_answer_summary.xml（浅灰卡：正确答案 / 你的答案）
    · 下：view_fb_analysis_card.xml（白底描边卡：可收起的解析）
  两张卡各自管自己的显隐，容器只在两张都空时整块收起（由 AnswerBlock 控）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <include
        android:id="@+id/summary"
        layout="@layout/view_fb_answer_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- ===== 统计三项：答题时间 / 历史正确率 / 易错项 =====
         对齐参考应用解析页的统计条（那边是全站口径，这边用本机记录聚合）。
         有数据才出现；样式沿用站内统计格（值粗体着色 + 标签灰小字 + 细竖线） -->
    <LinearLayout
        android:id="@+id/statsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_space_12"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout style="@style/FbSolutionStatCell">
            <TextView
                android:id="@+id/tvStatTime"
                style="@style/FbSolutionStatValue"
                android:textColor="@color/fb_primary"
                tools:text="42秒" />
            <TextView
                style="@style/FbSolutionStatLabel"
                android:text="@string/solution_stat_time" />
        </LinearLayout>

        <View style="@style/FbSolutionStatDivider" />

        <LinearLayout style="@style/FbSolutionStatCell">
            <TextView
                android:id="@+id/tvStatRate"
                style="@style/FbSolutionStatValue"
                android:textColor="@color/fb_success"
                tools:text="86%" />
            <TextView
                style="@style/FbSolutionStatLabel"
                android:text="@string/solution_stat_rate" />
        </LinearLayout>

        <View style="@style/FbSolutionStatDivider" />

        <LinearLayout style="@style/FbSolutionStatCell">
            <TextView
                android:id="@+id/tvStatTrap"
                style="@style/FbSolutionStatValue"
                android:textColor="@color/fb_danger"
                tools:text="C" />
            <TextView
                style="@style/FbSolutionStatLabel"
                android:text="@string/solution_stat_trap" />
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/analysis"
        layout="@layout/view_fb_analysis_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_space_12" />
</LinearLayout>
