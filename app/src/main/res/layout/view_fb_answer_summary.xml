<?xml version="1.0" encoding="utf-8"?>
<!--
  作答小结卡（解析块的上半张卡）：
  · 浅灰圆角卡，左右两栏「正确答案 / 你的答案」，答案值 18sp 加粗、按对错着色
  · 右栏内容在右半区居中（对齐参考截图）；部分得分时卡底补一行分数
  只负责「答案」，解析在 view_fb_analysis_card.xml——两张卡各自成块，谁没内容谁不出现
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_fb_note"
    android:orientation="vertical"
    android:paddingStart="@dimen/fb_space_16"
    android:paddingTop="@dimen/fb_space_16"
    android:paddingEnd="@dimen/fb_space_16"
    android:paddingBottom="@dimen/fb_space_16"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- 左栏：正确答案 -->
        <LinearLayout
            android:id="@+id/correctGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCorrectLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/answer_label_correct"
                android:textColor="@color/fb_text_meta"
                android:textSize="@dimen/fb_text_body_sm" />

            <TextView
                android:id="@+id/tvCorrectValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/fb_success"
                android:textSize="@dimen/fb_answer_value_size"
                android:textStyle="bold"
                tools:text="B" />
        </LinearLayout>

        <!-- 右栏：你的答案 -->
        <LinearLayout
            android:id="@+id/mineGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMineLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/answer_label_mine"
                android:textColor="@color/fb_text_meta"
                android:textSize="@dimen/fb_text_body_sm" />

            <TextView
                android:id="@+id/tvMineValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textSize="@dimen/fb_answer_value_size"
                android:textStyle="bold"
                tools:text="D" />
        </LinearLayout>
    </LinearLayout>

    <!-- 只有部分得分才补这一行：正确 / 错误由上面的颜色说明，分数只能靠文字 -->
    <TextView
        android:id="@+id/tvResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fb_space_8"
        android:textColor="@color/fb_warning"
        android:textSize="@dimen/fb_text_item_sub"
        android:visibility="gone"
        tools:text="部分得分 2/5"
        tools:visibility="visible" />
</LinearLayout>
