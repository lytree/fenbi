<?xml version="1.0" encoding="utf-8"?>
<!--
  平板尺寸令牌（最小宽度 ≥ 600dp 生效，覆盖 values/dimens.xml 里同名的项）。

  手机那套是按 1080x1920 @280dpi 量出来的：正文 16sp、选项圆标 32dp。
  这套数值搬到 8~12 寸平板上会「像手机」——字偏小、触控目标偏小、留白太窄。
  这里统一按 +15%~20% 放大；卷面宽度不设上限（铺满可用宽度），只把题块内的左右留白放宽到 32dp（≈5% 屏宽）。

  注意：放大时**圆角要跟着间距走**（胶囊按钮的半径 = 高度的一半），否则会出现「大按钮小圆角」。
-->
<resources>

    <!-- ===== 顶栏 ===== -->
    <dimen name="fb_bar_h">56dp</dimen>
    <dimen name="fb_title_bar_h">56dp</dimen>
    <dimen name="fb_bar_item_width">34dp</dimen>
    <dimen name="fb_bar_padding_left">20dp</dimen>
    <dimen name="fb_bar_pad_end">20dp</dimen>
    <dimen name="fb_bar_item_gap">20dp</dimen>
    <dimen name="fb_bar_paper_title">15sp</dimen>

    <!-- ===== 题块留白（宽度不设上限，铺满屏宽） =====
         左右留白按「约 5% 屏宽」：600~719dp 宽 → 5% = 30~36dp，取 32dp。 -->
    <dimen name="fb_page_padding_h">24dp</dimen>
    <dimen name="fb_card_gap">20dp</dimen>
    <dimen name="fb_content_padding_h">32dp</dimen>

    <!-- ===== 题干 / 选项字号 ===== -->
    <dimen name="fb_question_text_size">19sp</dimen>
    <dimen name="fb_question_line_space">8dp</dimen>
    <dimen name="fb_option_text_size">18sp</dimen>
    <dimen name="fb_option_line_space">6dp</dimen>
    <dimen name="fb_type_tag_text_size">12sp</dimen>

    <!-- ===== 选项圆标（触控目标 ≥ 46dp） ===== -->
    <dimen name="fb_option_circle">46dp</dimen>
    <dimen name="fb_option_circle_text_size">18sp</dimen>
    <dimen name="fb_option_row_padding_v">13dp</dimen>
    <dimen name="fb_option_row_padding_start">20dp</dimen>
    <dimen name="fb_option_text_gap">12dp</dimen>

    <!-- ===== 答题卡 ===== -->
    <dimen name="fb_card_num_size">52dp</dimen>
    <dimen name="fb_card_num_pad">6dp</dimen>
    <dimen name="fb_card_num_text_size">16sp</dimen>
    <dimen name="fb_sheet_height_percent">0.62</dimen>

    <!-- ===== 弹窗 ===== -->
    <dimen name="fb_dialog_btn_h">48dp</dimen>
    <dimen name="fb_dialog_pad">28dp</dimen>

    <!-- ===== 通用间距 / 圆角 ===== -->
    <dimen name="fb_page_pad">24dp</dimen>
    <dimen name="fb_card_pad">20dp</dimen>
    <dimen name="fb_card_gap_v">16dp</dimen>
    <dimen name="fb_section_gap">28dp</dimen>

    <!-- 按钮 50dp 高 → 胶囊半径 25dp -->
    <dimen name="fb_btn_h">50dp</dimen>
    <dimen name="fb_btn_radius">25dp</dimen>
    <dimen name="fb_btn_text_size">16sp</dimen>

    <!-- 标签 / chip / 行高 -->
    <dimen name="fb_tag_pad_h">8dp</dimen>
    <dimen name="fb_tag_pad_v">3dp</dimen>
    <dimen name="fb_chip_h">34dp</dimen>
    <dimen name="fb_chip_pad_h">14dp</dimen>
    <dimen name="fb_radius_chip">17dp</dimen>
    <dimen name="fb_row_h">60dp</dimen>
    <dimen name="fb_list_row_h">60dp</dimen>
    <dimen name="fb_icon_size">22dp</dimen>
    <dimen name="fb_icon_sm_size">18dp</dimen>
    <dimen name="fb_bottom_bar_pad_v">12dp</dimen>

    <!-- ===== 字号 ===== -->
    <dimen name="fb_text_display">44sp</dimen>
    <dimen name="fb_text_page_title">22sp</dimen>
    <dimen name="fb_text_bar_title">19sp</dimen>
    <dimen name="fb_text_card_title">17sp</dimen>
    <dimen name="fb_text_item_title">16sp</dimen>
    <dimen name="fb_text_body_size">15sp</dimen>
    <dimen name="fb_text_body_sm">14sp</dimen>
    <dimen name="fb_text_item_sub">13sp</dimen>
    <dimen name="fb_text_tag">12sp</dimen>
    <dimen name="fb_text_group">15sp</dimen>

    <!-- ===== 空态 / 导航 ===== -->
    <dimen name="fb_empty_pad_h">60dp</dimen>
    <dimen name="fb_empty_offset">80dp</dimen>
    <dimen name="fb_nav_h">60dp</dimen>
    <dimen name="fb_nav_icon">24dp</dimen>
</resources>
