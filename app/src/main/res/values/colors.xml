<?xml version="1.0" encoding="utf-8"?>
<!--
  粉笔真品实测色板（1080x1920 @ 280dpi 抓取自 com.fenbi.android.servant 的
  ObjectiveExerciseActivity / 答题卡弹层）。所有色值均为像素采样结果，非估计值。
-->
<resources>
    <color name="primary">#3C7BFC</color>
    <color name="primary_dark">#2A5FD6</color>
    <color name="accent">#FF7A45</color>

    <color name="bg">#F9FAFC</color>
    <color name="card">#FFFFFF</color>
    <color name="text_primary">#3C3D3F</color>
    <color name="text_secondary">#8A8F99</color>
    <color name="divider">#ECEDEF</color>

    <color name="option_border">#E8EBF2</color>
