    <color name="fb_page_bg">#F9FAFC</color>
    <color name="fb_card_bg">#FFFFFF</color>
    <color name="fb_divider">#ECEDEF</color>

    <!-- 文字层级 -->
    <color name="fb_text_title">#3C3D3F</color>
    <color name="fb_text_body">#4A4B4D</color>
    <color name="fb_text_primary">#3C3D3F</color>
    <color name="fb_text_meta">#8A8F99</color>
