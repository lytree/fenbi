<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 统一用 Light 主题：本 App 的「夜间模式」是答题页自绘的局部换色，
         不走系统 DayNight，否则 Spinner 等系统控件在深色系统下会出现白字白底 -->
    <style name="Theme.QBank" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/fb_bar_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/fb_bar_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <!-- 「更多」面板：字号 Aa 三档（宽度均分，选中深色） -->
    <style name="FbFontAa">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/fb_text_meta</item>
    </style>

    <!-- 「更多」面板：分段胶囊（等分，选中白底深字） -->
    <style name="FbSegmentPill">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_fb_segment_pill_off</item>
        <item name="android:textColor">@color/fb_segment_text</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ============================================================
         全站统一版式（非答题页）
         ============================================================ -->

    <!-- 底部导航文字（10sp，颜色仍由 itemTextColor 的状态选择器控制） -->
    <style name="FbNavLabel">
        <item name="android:textSize">@dimen/fb_nav_text</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- 页码 / 大标题 -->
    <style name="FbPageTitle">
        <item name="android:textSize">@dimen/fb_text_page_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/fb_text_title</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 列表项主标题 15sp -->
    <style name="FbItemTitle">
        <item name="android:textSize">@dimen/fb_text_item_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/fb_text_title</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- 列表项副标题 12sp -->
    <style name="FbItemSub">
        <item name="android:textSize">@dimen/fb_text_item_sub</item>
        <item name="android:textColor">@color/fb_text_meta</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- 分组标题 13sp -->
    <style name="FbGroupTitle">
        <item name="android:textSize">@dimen/fb_text_group</item>
        <item name="android:textColor">@color/fb_text_meta</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 白卡：8dp 圆角 + 16dp 内边距 -->
    <style name="FbCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_fb_card</item>
        <item name="android:padding">@dimen/fb_card_pad</item>
    </style>

    <!-- 主按钮：46dp 高 / 23dp 胶囊 / 主蓝白字 -->
    <style name="FbPrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">@dimen/fb_btn_h</item>
        <item name="android:textSize">@dimen/fb_btn_text_size</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">@dimen/fb_btn_h</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/fb_primary</item>
        <item name="cornerRadius">@dimen/fb_btn_radius</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="iconTint">#FFFFFF</item>
        <item name="iconSize">18dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
    </style>

    <!-- 次级按钮：浅蓝底 + 主蓝字 -->
    <style name="FbGhostButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">@dimen/fb_btn_h</item>
        <item name="android:textSize">@dimen/fb_btn_text_size</item>
        <item name="android:textColor">@color/fb_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">@dimen/fb_btn_h</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/fb_ghost_bg</item>
        <item name="cornerRadius">@dimen/fb_btn_radius</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/fb_ripple</item>
        <item name="iconTint">@color/fb_primary</item>
        <item name="iconSize">18dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
    </style>

    <!-- 纯文字按钮 -->
    <style name="FbTextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/fb_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@color/fb_ripple</item>
    </style>

    <!-- 输入框：8dp 圆角描边 -->
    <style name="FbInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/fb_radius_field</item>
        <item name="boxCornerRadiusTopEnd">@dimen/fb_radius_field</item>
        <item name="boxCornerRadiusBottomStart">@dimen/fb_radius_field</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/fb_radius_field</item>
        <item name="boxStrokeColor">@color/fb_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.4dp</item>
        <item name="hintTextColor">@color/fb_text_meta</item>
        <item name="android:textColorHint">@color/fb_text_hint</item>
    </style>

    <!-- 复选框 -->
    <style name="FbCheckBox" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/fb_text_secondary</item>
        <item name="buttonTint">@color/fb_check_tint</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <!-- 设置项开关行 -->
    <style name="FbSwitchRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:paddingStart">@dimen/fb_card_pad</item>
        <item name="android:paddingEnd">@dimen/fb_card_pad</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="TextBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="TextMeta">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- 「更多」面板里的 segmented 控件项 -->
    <style name="FbSegment">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">46dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:background">@drawable/bg_fb_segment</item>
        <item name="android:textColor">@color/fb_segment_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginEnd">4dp</item>
    </style>

    <style name="FbSegmentSelected">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">46dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:background">@drawable/bg_fb_segment_selected</item>
        <item name="android:textColor">@color/fb_segment_text_sel</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginEnd">4dp</item>
    </style>
</resources>
