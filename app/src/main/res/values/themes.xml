<?xml version="1.0" encoding="utf-8"?>
<!--
  主题（只放 Theme，不放组件样式；组件样式见 styles.xml）。

  统一用 Light 主题：本 App 的「夜间模式」是答题页自绘的局部换色，
  不走系统 DayNight，否则 Spinner 等系统控件在深色系统下会出现白字白底。
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.QBank" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/fb_primary</item>
        <item name="colorPrimaryDark">@color/fb_primary_deep</item>
        <item name="colorAccent">@color/fb_primary</item>
        <item name="colorControlActivated">@color/fb_primary</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/fb_bar_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/fb_bar_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowBackground">@color/fb_page_bg</item>
        <!-- 弹窗默认走 Material 时也保持同一套圆角/底色，避免漏改的弹窗风格跳脱 -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.QBank.Dialog</item>
    </style>

    <!-- 兜底的系统弹窗样式：万一还有 Material AlertDialog 没换成 FbDialog，
         也用白底 12dp 圆角 + 主蓝按钮，不至于一眼看出「不是这个 App 的」 -->
    <style name="ThemeOverlay.QBank.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/fb_primary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.QBank.Dialog</item>
        <item name="android:textColorPrimary">@color/fb_text_title</item>
        <item name="android:textColorSecondary">@color/fb_text_meta</item>
    </style>

    <style name="ShapeAppearance.QBank.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/fb_radius_sheet</item>
    </style>

    <!-- 答题卡弹层（AnswerCardActivity 用）：透明窗口 + 不再额外压暗。
         弹出来时下面的答题页仍然可见（只隔一层半透明遮罩），而不是「换了一屏」。
         进出场动画由 Activity 自己驱动（弹层上滑 / 下滑），所以这里不加 windowAnimationStyle。 -->
    <style name="Theme.QBank.Popup" parent="Theme.QBank">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
